---
/* src/pages/admin.astro
 *
 * Thin redirect to /admin/index.html (the real Decap CMS entry point,
 * in public/). Exists only because Astro's dev server doesn't do
 * directory-index resolution for public/ files the way production
 * static hosting does — /admin/ 404s in dev without this, even though
 * /admin/index.html works fine everywhere. `astro build` skips this
 * file in favor of the public one, so it has no effect in production;
 * this is purely a local-dev convenience for the documented
 * `npm run dev` + `npx decap-server` workflow.
 *
 * Do not duplicate the CMS bootstrap (decap-cms.js + preview-templates.js)
 * here — that lives solely in public/admin/index.html.
 */
return Astro.redirect("/admin/index.html", 302);
---
