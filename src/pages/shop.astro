---
// src/pages/shop.astro
//
// Catalog page. Pulls products at build time from Shopify Storefront API
// (or mock data if env vars aren't set) and renders a card grid. Each card
// links to the Shopify-hosted product page in a new tab.
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import Kicker from "../components/Kicker.astro";
import { getProducts } from "../lib/shopify";

const products = await getProducts();
const isEmpty = products.length === 0;
---

<BaseLayout
        title="DRAW THE BLOCK — SHOP"
        current="shop"
        peekKey="shop"
        description="Shop Draw The Block merch and limited-edition pieces. Apparel, prints, and exclusive collaborations with our artists."
>
    <main class="shop stack">

        <Kicker label="SHOP" />

        {isEmpty ? (
                <p class="shop__empty">Shop is currently being updated.</p>
        ) : (
                <div class="shop__grid">
                    {products.map((product) => (
                            <ProductCard product={product} />
                    ))}
                </div>
        )}

    </main>

    <style>
        .shop {
            width: 100%;
            max-width: 720px;
            margin: 0 auto;
            text-align: left;
            padding-top: var(--space-3);
        }


        .shop__grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: var(--space-4);
            padding: 8px;
        }

        @media (min-width: 769px) {
            .shop__grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        .shop__empty {
            margin: 0;
            font-size: 14px;
            opacity: 0.75;
            font-style: italic;
        }
    </style>
</BaseLayout>