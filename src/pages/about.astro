---
// src/pages/about.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import Kicker from "../components/Kicker.astro";
import { getCollection, getEntry } from "astro:content";

const team = (await getCollection("team"))
    .map((entry) => entry.data)
    .sort((a, b) => a.displayOrder - b.displayOrder);

// Mission and quote from the pageContent collection. Both are wrapped
// in catch(() => null) so a missing entry doesn't crash the build —
// the page just renders without that section. This matters when
// content is brand new and not yet seeded.


const missionEntry = await getEntry("pageContent", "mission").catch(() => null);
const mission = missionEntry?.data?.mission?.trim() ?? null;

const quoteEntry = await getEntry("pageContent", "quote").catch(() => null);
const quote = quoteEntry?.data?.quote?.trim() ?? null;
const attribution = quoteEntry?.data?.attribution?.trim() ?? null;
---

<BaseLayout title="ABOUT — DRAW THE BLOCK" current="about">
  <section class="about">

    {/* MISSION */}
    {mission && (
        <p class="about__mission prose">{mission}</p>
    )}

    {/* MEET THE TEAM */}
    <Kicker label="MEET THE TEAM" />

    <div class="about__teamGrid" aria-label="Team members">
      {team.map((member) => {
        const Card = (
            <article class="teamCard">
              <div class="teamCard__photoFrame">
                <img
                    class="teamCard__photo"
                    src={member.image}
                    alt={member.name}
                    loading="lazy"
                />
              </div>

              <div class="teamCard__meta">
                <div class="teamCard__name">{member.name}</div>
                <div class="teamCard__role">{member.role}</div>
              </div>
            </article>
        );

        return member.website ? (
            <a
                class="teamCard__link"
                href={member.website}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${member.name} website`}
            >
              {Card}
            </a>
        ) : (
            Card
        );
      })}
    </div>

    {/* QUOTE */}
    {quote && (
        <blockquote class="about__quote">
          <p class="about__quoteText">{quote}</p>
          {attribution && (
              <footer class="about__quoteAttr">— {attribution}</footer>
          )}
        </blockquote>
    )}

  </section>

  <style>
    :global(:root) {
      --team-img-w: 225px;
      --team-img-h: 325px;
    }

    .about {
      width: 100%;
      max-width: 520px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-5);
    }

    /* MISSION
       Sits at the top, sets the page's purpose before the team grid. */
    .about__mission {
      max-width: 460px;
      text-align: center;
      font-size: 15px;
      line-height: 1.55;
      opacity: 0.95;
      margin: 0;
    }

    /* TEAM GRID — unchanged from before */
    .about__teamGrid {
      width: 100%;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-5);
      justify-items: center;
      margin-top: var(--space-2);
    }

    .teamCard__link {
      color: inherit;
      text-decoration: none;
      display: inline-flex;
      width: var(--team-img-w);
    }

    .teamCard {
      width: var(--team-img-w);
      display: flex;
      flex-direction: column;
      align-items: stretch;
      max-width: var(--team-img-w);
      min-width: var(--team-img-w);
    }

    .teamCard__photoFrame {
      background: transparent;
      padding: 0;
      margin: 0;
      display: block;
    }

    .teamCard__photo {
      width: var(--team-img-w);
      height: var(--team-img-h);
      object-fit: cover;
      display: block;
    }

    .teamCard__meta {
      width: var(--team-img-w);
      max-width: var(--team-img-w);
      min-width: var(--team-img-w);
      box-sizing: border-box;
      background: #fff;
      padding: 6px 14px 6px;
      margin: 0;
      border: 0;
      box-shadow: none;
      position: relative;
      text-align: left;
    }

    .teamCard__meta::before,
    .teamCard__meta::after,
    .teamCard::before,
    .teamCard::after {
      content: none !important;
      display: none !important;
    }

    .teamCard__name {
      font-weight: 800;
      font-size: 22px;
      text-transform: uppercase;
      letter-spacing: 0.02em;
      color: #000;
    }

    .teamCard__role {
      margin-top: 2px;
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      opacity: 0.85;
      color: #f7152b;
    }

    /* QUOTE
       Sits below the team grid as the closing emotional beat —
       the "why" after the "what" and "who". Centered, slightly
       larger and italic, with attribution on its own line. */
    .about__quote {
      max-width: 460px;
      margin: 0;
      text-align: center;
      padding: var(--space-3) 0;
    }

    .about__quoteText {
      font-style: italic;
      font-size: 17px;
      line-height: 1.5;
      margin: 0;
      opacity: 0.95;
    }

    .about__quoteAttr {
      margin-top: var(--space-2);
      font-size: 11px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      opacity: 0.7;
    }

    /* Mobile collapse — single column for the team grid */
    @media (max-width: 520px) {
      .about__teamGrid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>