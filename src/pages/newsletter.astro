---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
    title="Newsletter | DRAW THE BLOCK"
    current="newsletter"
    peekKey="newsletter"
    description="Subscribe to the Draw The Block newsletter for updates on upcoming events, new vendors, and exclusive drops."
>
  <div class="stack prose">
    <h1>Join the Newsletter</h1>
    <p>Subscribe to stay updated on the latest DRAW THE BLOCK announcements, events, and drops.</p>

    <div class="form-error" role="alert" data-error-banner hidden>
      <span data-error-text></span>
    </div>

    <!--
      Form posts to /api/subscribe (a Netlify Function compiled from
      src/pages/api/subscribe.ts). On success, the function redirects
      the user to /thank-you. On failure, it redirects back here with
      ?error=<code> which a client-side script reads to show the
      banner above.
    -->
    <form
        class="newsletter-form"
        action="/api/subscribe"
        method="POST"
        data-netlify="true"
        name="newsletter"
    >
      <input type="hidden" name="form-name" value="newsletter" />

      <div class="form-group">
        <label for="firstName">First Name</label>
        <input type="text" id="firstName" name="firstName" required />
      </div>

      <div class="form-group">
        <label for="lastName">Last Name</label>
        <input type="text" id="lastName" name="lastName" required />
      </div>

      <div class="form-group">
        <label for="email">Email Address</label>
        <input type="email" id="email" name="email" required />
      </div>

      <p class="form-note">
        You'll receive a confirmation email to verify your subscription.
      </p>

      <button type="submit" class="submit-btn">Subscribe</button>
    </form>
  </div>
</BaseLayout>

<style>
  h1 {
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .newsletter-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 400px;
    margin: var(--space-5) auto;
    text-align: left;
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .form-group label {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .form-group input {
    padding: var(--space-3);
    font-size: var(--fs-body);
    border: 1px solid var(--color-white-20);
    background: transparent;
    color: var(--color-text);
    border-radius: 4px;
    font-family: var(--font-body);
  }
  .form-group input:focus {
    border-color: var(--color-text);
    outline: none;
  }
  .form-error {
    max-width: 400px;
    margin: var(--space-4) auto 0;
    padding: var(--space-3);
    border: 1px solid #FFD400;
    color: #FFD400;
    border-radius: 4px;
    font-size: 14px;
    text-align: center;
  }
  .form-error[hidden] {
    display: none;
  }
  .form-note {
    font-size: 12px;
    opacity: 0.7;
    text-align: center;
    margin: 0;
  }
  .submit-btn {
    margin-top: var(--space-2);
    padding: var(--space-3) var(--space-4);
    font-size: 14px;
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    background: var(--color-text);
    color: var(--color-strip);
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-weight: bold;
    transition: opacity 0.2s;
  }
  .submit-btn:hover {
    opacity: 0.8;
  }
</style>

<script>
  // Read the error code from the URL on the client side and show
  // a banner with the appropriate message. We do this client-side
  // because Astro.url.searchParams was unreliable in our SSR setup.
  function showErrorIfPresent() {
    const params = new URLSearchParams(window.location.search);
    const errorCode = params.get("error");

    const errorMessages: Record<string, string> = {
      email: "Please enter a valid email address.",
      config: "We're having trouble with our signup system. Please try again later.",
      api: "Something went wrong. Please try again.",
      network: "We couldn't reach our newsletter service. Please try again.",
      invalid: "Form submission failed. Please try again.",
    };

    const banner = document.querySelector<HTMLElement>("[data-error-banner]");
    const textEl = document.querySelector<HTMLElement>("[data-error-text]");

    if (!banner || !textEl) return;

    if (errorCode && errorMessages[errorCode]) {
      textEl.textContent = errorMessages[errorCode];
      banner.removeAttribute("hidden");
    } else {
      banner.setAttribute("hidden", "");
    }
  }

  showErrorIfPresent();
  document.addEventListener("astro:page-load", showErrorIfPresent);
</script>