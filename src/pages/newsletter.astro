---
export const prerender = true;

import BaseLayout from "../layouts/BaseLayout.astro";

// Pull error code from query string for inline display.
const url = new URL(Astro.request.url);
const errorCode = url.searchParams.get("error");

const errorMessages: Record<string, string> = {
  email: "Please enter a valid email address.",
  config: "We're having trouble with our signup system. Please try again later.",
  api: "Something went wrong. Please try again.",
  network: "We couldn't reach our newsletter service. Please try again.",
  invalid: "Form submission failed. Please try again.",
};

const errorMessage = errorCode ? errorMessages[errorCode] : null;
---

<BaseLayout title="Newsletter | DRAW THE BLOCK" current="newsletter">
  <div class="stack prose">
    <h1>Join the Newsletter</h1>
    <p>Subscribe to stay updated on the latest DRAW THE BLOCK announcements, events, and drops.</p>

    {errorMessage && (
        <div class="form-error" role="alert">
          {errorMessage}
        </div>
    )}

    <form class="newsletter-form" action="/api/subscribe" method="POST">
      <div class="form-group">
        <label for="firstName">First Name</label>
        <input type="text" id="firstName" name="firstName" required />
      </div>

      <div class="form-group">
        <label for="lastName">Last Name</label>
        <input type="text" id="lastName" name="lastName" required />
      </div>

      <div class="form-group">
        <label for="email">Email Address</label>
        <input type="email" id="email" name="email" required />
      </div>

      <p class="form-note">
        You'll receive a confirmation email to verify your subscription.
      </p>

      <button type="submit" class="submit-btn">Subscribe</button>
    </form>
  </div>
</BaseLayout>

<style>
  h1 {
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .newsletter-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 400px;
    margin: var(--space-5) auto;
    text-align: left;
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .form-group label {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .form-group input {
    padding: var(--space-3);
    font-size: var(--fs-body);
    border: 1px solid var(--color-white-20);
    background: transparent;
    color: var(--color-text);
    border-radius: 4px;
    font-family: var(--font-body);
  }
  .form-group input:focus {
    border-color: var(--color-text);
    outline: none;
  }
  .form-error {
    max-width: 400px;
    margin: var(--space-4) auto 0;
    padding: var(--space-3);
    border: 1px solid #FFD400;
    color: #FFD400;
    border-radius: 4px;
    font-size: 14px;
    text-align: center;
  }
  .form-note {
    font-size: 12px;
    opacity: 0.7;
    text-align: center;
    margin: 0;
  }
  .submit-btn {
    margin-top: var(--space-2);
    padding: var(--space-3) var(--space-4);
    font-size: 14px;
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    background: var(--color-text);
    color: var(--color-strip);
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-weight: bold;
    transition: opacity 0.2s;
  }
  .submit-btn:hover {
    opacity: 0.8;
  }
</style>