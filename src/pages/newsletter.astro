---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Newsletter | DRAW THE BLOCK" current="newsletter">
  <div class="stack prose">
    <h1>Join the Newsletter</h1>
    <p>Subscribe to stay updated on the latest DRAW THE BLOCK announcements, events, and drops.</p>
    
    <!-- 
      Replace the action URL with your form provider (e.g., Mailchimp, Formspree).
      If you host on Netlify, adding data-netlify="true" to the form will automatically capture submissions.
    -->
    <form class="newsletter-form" action="/thank-you" method="POST" data-netlify="true" name="newsletter">
      <input type="hidden" name="form-name" value="newsletter" />
      <div class="form-group">
        <label for="firstName">First Name</label>
        <input type="text" id="firstName" name="firstName" required />
      </div>

      <div class="form-group">
        <label for="lastName">Last Name</label>
        <input type="text" id="lastName" name="lastName" required />
      </div>

      <div class="form-group">
        <label for="email">Email Address</label>
        <input type="email" id="email" name="email" required />
      </div>

      <button type="submit" class="submit-btn">Subscribe</button>
    </form>
  </div>
</BaseLayout>

<style>
  h1 {
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .newsletter-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 400px;
    margin: var(--space-5) auto;
    text-align: left;
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .form-group label {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .form-group input {
    padding: var(--space-3);
    font-size: var(--fs-body);
    border: 1px solid var(--color-white-20);
    background: transparent;
    color: var(--color-text);
    border-radius: 4px;
    font-family: var(--font-body);
  }
  .form-group input:focus {
    border-color: var(--color-text);
    outline: none;
  }
  .submit-btn {
    margin-top: var(--space-2);
    padding: var(--space-3) var(--space-4);
    font-size: 14px;
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    background: var(--color-text);
    color: var(--color-strip);
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-weight: bold;
    transition: opacity 0.2s;
  }
  .submit-btn:hover {
    opacity: 0.8;
  }
</style>