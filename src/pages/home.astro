---
// src/pages/home.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import Countdown from "../components/Countdown.astro";
import EventCard from "../components/EventCard.astro";
import Kicker from "../components/Kicker.astro";
import { getCollection, getEntry, type CollectionEntry } from "astro:content";

type EventEntry = CollectionEntry<"events">;

const events = (await getCollection("events")) as EventEntry[];
const now = new Date();

// All featured events, sorted.
const featuredAll = events
    .filter((e) => e.data.featured)
    .slice()
    .sort((a, b) => a.data.startDate.getTime() - b.data.startDate.getTime());

// Cap display at 2.
const featuredDisplay = featuredAll.slice(0, 2);

// Countdown targets earliest upcoming featured (from all featured, not just the first 2).
const countdownEvent =
    featuredAll.find((e) =>
        e.data.endDate ? e.data.endDate >= now : e.data.startDate >= now
    ) ?? null;

const targetIso = countdownEvent ? countdownEvent.data.startDate.toISOString() : null;

const singleFeatured = featuredAll.length === 1 ? featuredAll[0] : null;

// Tagline content (image preferred, text fallback). Both are optional —
// if neither is set, no tagline renders. We don't crash on missing entries
// either, since this is brand-new content the client may not have set yet.
const taglineEntry = await getEntry("pageContent", "tagline").catch(() => null);
const taglineImage = taglineEntry?.data?.taglineImage ?? null;
const taglineText = taglineEntry?.data?.taglineText?.trim() || null;
---

<BaseLayout title="DRAW THE BLOCK — HOME" current="home">
  <div class="home">

    {/* TAGLINE — image first, text fallback, nothing if neither set. */}
    {taglineImage && (
        <div class="home__tagline">
          <img src={taglineImage} alt="" class="home__taglineImg" loading="eager" />
        </div>
    )}

    {!taglineImage && taglineText && (
        <div class="home__tagline">
          <p class="home__taglineText">{taglineText}</p>
        </div>
    )}

    {/* FEATURED EVENT(S) */}
    {singleFeatured && (
        <section class="featuredSingle">
          <Kicker label="FEATURED EVENT" />

          <EventCard
              href={`/events/${singleFeatured.slug}`}
              title={singleFeatured.data.title}
              image={singleFeatured.data.image}
              description={singleFeatured.data.description}
              startDate={singleFeatured.data.startDate}
              endDate={singleFeatured.data.endDate}
              endTime={singleFeatured.data.endTime}
              location={singleFeatured.data.location}
          />
        </section>
    )}

    {!singleFeatured && featuredDisplay.length > 0 && (
        <section class="featuredMulti stack">
          <Kicker label="FEATURED EVENTS" />

          <div class="eventsList">
            {featuredDisplay.map((event) => (
                <EventCard
                    href={`/events/${event.slug}`}
                    title={event.data.title}
                    image={event.data.image}
                    description={event.data.description}
                    startDate={event.data.startDate}
                    endDate={event.data.endDate}
                    endTime={event.data.endTime}
                    location={event.data.location}
                />
            ))}
          </div>
        </section>
    )}

    {/* COUNTDOWN */}
    <section class="home__countdown" aria-label="Countdown to featured event">
      {targetIso ? (
          <>
            <Kicker label="COUNTDOWN" />
            <Countdown targetIso={targetIso} />
          </>
      ) : (
          <div class="eventNone">
            <Kicker label="NO UPCOMING FEATURED EVENTS" />
            <p class="prose">Check back soon!</p>
          </div>
      )}
    </section>

    {/* MASCOT + TYPE COMPOSITION */}
    <section class="home__art" aria-label="Draw The Block">
      <img
          src="/images/mascot_jacket.png"
          alt="Draw The Block mascot"
          class="home__mascot"
          loading="eager"
      />
      <div class="home__wordmark" aria-hidden="true">
        <span class="home__wordmarkLine">DRAW</span>
        <span class="home__wordmarkLine">THE</span>
        <span class="home__wordmarkLine">BLOCK</span>
      </div>
    </section>

  </div>

  <style>
    .home {
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: var(--space-6);
    }

    /* TAGLINE
       Image renders at its native dimensions up to 890px wide (the
       client's intended size). Text fallback is small, dimmer, italic
       — clearly secondary to an image-style hero treatment. */
    .home__tagline {
      width: 100%;
      display: flex;
      justify-content: center;
      margin-top: var(--space-3);
    }

    .home__taglineImg {
      width: 100%;
      max-width: 890px;
      height: auto;
      display: block;
    }

    .home__taglineText {
      margin: 0;
      font-size: 14px;
      letter-spacing: 0.04em;
      opacity: 0.9;
      max-width: 60ch;
    }

    /* SINGLE FEATURED */
    .featuredSingle {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      align-items: center;
    }

    /* MULTI FEATURED */
    .featuredMulti {
      width: 100%;
      text-align: left;
    }

    .eventsList {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-4);
      margin-top: var(--space-2);
      /* Scale-up hover needs breathing room so the shadow doesn't clip. */
      padding: 8px;
    }

    @media (min-width: 720px) {
      .eventsList {
        grid-template-columns: 1fr 1fr;
        align-items: start;
      }
    }

    /* COUNTDOWN */
    .home__countdown {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-3);
      width: 100%;
    }

    /* MASCOT */
    .home__art {
      width: 100%;
      display: flex;
      flex-direction: row;
      align-items: end;
      justify-content: center;
      gap: 0;
      padding: var(--space-3) 0;
    }

    .home__mascot {

      width: clamp(180px, 24vw, 380px);
      height: auto;
      display: block;
      flex-shrink: 0;
      margin-right: -2vw;
    }

    .home__wordmark {
      display: flex;
      flex-direction: column;
      align-items: flex-start; /* left-align text to hug the mascot */
      line-height: 0.85; /* tight stacking — each line sits close to the next */
      font-family: var(--font-display), system-ui, sans-serif;
      font-weight: 800;
      font-size: clamp(48px, 11vw, 160px); /* fluid sizing across viewports */
      letter-spacing: -0.02em; /* slight tightening at huge sizes */
      color: #fff;
      text-transform: uppercase;
    }

    .home__wordmarkLine {
      display: block;
    }

    /*
     * Stack vertically below 720px. Mascot on top (centered), type below.
     * The type stays centered too at this size — left-alignment only makes
     * sense when there's a mascot to the left of it.
     */
    @media (max-width: 720px) {
      .home__art {
        flex-direction: column;
        align-items: center;
        gap: var(--space-3);
      }

      .home__mascot {
        width: 60%;
        max-width: 280px;
      }

      .home__wordmark {
        align-items: center;
      }
    }
  </style>
</BaseLayout>