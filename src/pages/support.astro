---

import BaseLayout from "../layouts/BaseLayout.astro";
import Kicker from "../components/Kicker.astro";
import { getCollection } from "astro:content";

const donateEntries = await getCollection("donate");
const donate = donateEntries[0]?.data;

const sponsorEntries = await getCollection("sponsor");
const sponsor = sponsorEntries[0]?.data;

// Build the Ko-fi embed URL from the bare Ko-fi page URL the client provides.
// Pattern: https://ko-fi.com/<handle>  →  https://ko-fi.com/<handle>/?hidefeed=true&widget=true&embed=true
function buildKofiEmbed(url: string | undefined): string | null {
    if (!url) return null;
    const trimmed = url.replace(/\/+$/, "");
    return `${trimmed}/?hidefeed=true&widget=true&embed=true`;
}

const kofiEmbedSrc = buildKofiEmbed(donate?.kofiUrl);
---

<BaseLayout title="DRAW THE BLOCK — SUPPORT" current="support">
    <main class="support">

        <!-- ─────────────  DONATE  ───────────── -->
        <section id="donate" class="support__section" aria-labelledby="donate-heading">
            <Kicker label="DONATE" />

            {donate?.description && (
                    <p class="support__lede">{donate.description}</p>
            )}

            {kofiEmbedSrc ? (
                    <div class="support__kofi" aria-label="Support Draw The Block on Ko-fi">
                        <div class="support__kofiCard">
                            <iframe
                                    class="support__kofiFrame"
                                    id="kofiframe"
                                    src={kofiEmbedSrc}
                                    title="Draw The Block Ko-fi"
                                    loading="lazy"
                                    referrerpolicy="no-referrer-when-downgrade"
                            ></iframe>
                        </div>
                    </div>
            ) : (
                    <p class="support__empty">Ko-fi link is currently being updated.</p>
            )}
        </section>

        <!-- ─────────────  SPONSOR  ───────────── -->
        <section id="sponsor" class="support__section" aria-labelledby="sponsor-heading">
            <Kicker label="SPONSOR" />

            {sponsor?.description ? (
                    <p class="support__lede">{sponsor.description}</p>
            ) : (
                    <p class="support__lede" aria-hidden="true" style="visibility: hidden">Placeholder text mirrors donate lede height.</p>
            )}

            {sponsor?.stripeUrl ? (
                    <div class="support__sponsor">


                        {sponsor.poster && (
                                <a
                                        href={sponsor.stripeUrl}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="support__posterLink"
                                        aria-label="Sponsor Draw The Block"
                                >
                                    <img
                                            src={sponsor.poster}
                                            alt="Sponsor poster"
                                            class="support__poster"
                                    />
                                </a>
                        )}
                    </div>
            ) : (
                    <p class="support__empty">Sponsorship link is currently being updated.</p>
            )}
        </section>

    </main>

    <style>
        .support {
            width: 100%;
            margin: 0 auto;
            text-align: left;
            padding-top: var(--space-3);
        }

        .support__section {
            width: 100%;
            max-width: 520px;
            margin: 0 auto;
            padding-bottom: var(--space-6);
        }

        /* Add a hairline between sections so they read as separate "ways to give"
           rather than one continuous block. Doesn't fight the marquee-as-divider
           at the top of the page. */
        .support__section + .support__section {
            border-top: 1px solid rgba(255, 255, 255, 0.15);
            padding-top: var(--space-5);
        }

        .support__lede {
            margin: 0 0 var(--space-3);
            font-size: 16px;
            line-height: 1.5;
        }

        .support__empty {
            margin: 0;
            font-size: 13px;
            opacity: 0.7;
            font-style: italic;
        }

        /* ─── Donate / Ko-fi ─── */
        .support__kofi {
            display: flex;
            justify-content: center;
            width: 100%;
        }

        .support__kofiCard {
            /* Change width from 100% to max-content or a specific width */
            width: 100%;
            max-width: 400px; /* Ko-fi widgets usually hover around 360px-400px */
            background: #ffffff;
            border-radius: 12px;
            padding: 6px;
            /* Center the card if the section is wider than 400px */
            margin: 0 auto;
            box-sizing: border-box;
        }

        .support__kofiFrame {
            display: block;
            width: 100%;
            height: 580px;
            border: 0;
            border-radius: 8px;
            background: transparent;
            /* Ensure no internal iframe margins cause gaps */
            margin: 0;
        }

        @media (max-width: 420px) {
            .support__kofiFrame {
                height: 670px;
            }
        }

        /* Target the shift at high resolutions */
        @media (min-width: 1441px) {
            .support__kofi {
                justify-content: flex-start;
            }

            .support__kofiCard {
                /* Ensure it doesn't auto-center via margins */
                margin-left: 0;
                margin-right: auto;
            }
        }

        /* ─── Sponsor ─── */
        .support__sponsor {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: var(--space-3);
        }


        .support__posterLink {
            display: block;
            width: 100%;
            max-width: 100%;
            transition: opacity 180ms ease-out;
        }

        .support__posterLink:hover {
                   opacity: 0.85;
               }

               @media (prefers-reduced-motion: reduce) {
                       .support__posterLink {
                           transition: none;
                       }
               }

        .support__poster {
            max-width: 100%;
            height: auto;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            display: block;
        }

        @media (min-width: 1025px) {
            .support {
                display: flex;
                flex-direction: row;
                flex-wrap: wrap;
                gap: var(--space-6);
                align-items: flex-start;
                justify-content: center;
            }

            .support__section {
                flex: 1 1 0;
                max-width: 480px;
                margin: 0;
            }

            .support__section + .support__section {
                border-top: none;
                padding-top: 0;
            }
        }
    </style>
</BaseLayout>