---
// src/pages/support.astro
//
// Unified "ways to support the block" page.
// Two sections, anchor-linkable:
//   /support#donate   — Ko-fi widget
//   /support#sponsor  — Stripe button + poster
//
// The old /donate and /sponsor URLs 301-redirect to those anchors via
// astro.config.mjs's `redirects` map.
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const donateEntries = await getCollection("donate");
const donate = donateEntries[0]?.data;

const sponsorEntries = await getCollection("sponsor");
const sponsor = sponsorEntries[0]?.data;

// Build the Ko-fi embed URL from the bare Ko-fi page URL the client provides.
// Pattern: https://ko-fi.com/<handle>  →  https://ko-fi.com/<handle>/?hidefeed=true&widget=true&embed=true
function buildKofiEmbed(url: string | undefined): string | null {
    if (!url) return null;
    const trimmed = url.replace(/\/+$/, "");
    return `${trimmed}/?hidefeed=true&widget=true&embed=true`;
}

const kofiEmbedSrc = buildKofiEmbed(donate?.kofiUrl);
---

<BaseLayout title="DRAW THE BLOCK — SUPPORT" current="support">
    <main class="support">

        <!-- ─────────────  DONATE  ───────────── -->
        <section id="donate" class="support__section" aria-labelledby="donate-heading">
            <div class="kicker">[ DONATE ]</div>

            {donate?.description && (
                    <p class="support__lede">{donate.description}</p>
            )}

            {kofiEmbedSrc ? (
                    <div class="support__kofi" aria-label="Support Draw The Block on Ko-fi">
                        <div class="support__kofiCard">
                            <iframe
                                    class="support__kofiFrame"
                                    id="kofiframe"
                                    src={kofiEmbedSrc}
                                    title="Draw The Block Ko-fi"
                                    loading="lazy"
                                    referrerpolicy="no-referrer-when-downgrade"
                            ></iframe>
                        </div>
                    </div>
            ) : (
                    <p class="support__empty">Ko-fi link is currently being updated.</p>
            )}
        </section>

        <!-- ─────────────  SPONSOR  ───────────── -->
        <section id="sponsor" class="support__section" aria-labelledby="sponsor-heading">
            <div class="kicker">[ SPONSOR ]</div>

            {sponsor?.description && (
                    <p class="support__lede">{sponsor.description}</p>
            )}

            {sponsor?.stripeUrl ? (
                    <div class="support__sponsor">
                        <a
                                href={sponsor.stripeUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="support__stripeButton"
                        >
                            STRIPE
                        </a>

                        {sponsor.poster && (
                                <a
                                        href={sponsor.stripeUrl}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="support__posterLink"
                                        aria-label="Sponsor Draw The Block"
                                >
                                    <img
                                            src={sponsor.poster}
                                            alt="Sponsor poster"
                                            class="support__poster"
                                    />
                                </a>
                        )}
                    </div>
            ) : (
                    <p class="support__empty">Sponsorship link is currently being updated.</p>
            )}
        </section>

    </main>

    <style>
        .support {
            width: 100%;
            max-width: 520px;
            margin: 0 auto;
            text-align: left;
            padding-top: var(--space-3);
        }

        .support__section {
            padding-bottom: var(--space-6);
        }

        /* Add a hairline between sections so they read as separate "ways to give"
           rather than one continuous block. Doesn't fight the marquee-as-divider
           at the top of the page. */
        .support__section + .support__section {
            border-top: 1px solid rgba(255, 255, 255, 0.15);
            padding-top: var(--space-5);
        }

        .kicker {
            font-family: var(--font-display);
            font-size: 12px;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            opacity: 0.9;
            margin: 0 0 var(--space-2);
        }

        .support__lede {
            margin: 0 0 var(--space-3);
            font-size: 16px;
            line-height: 1.5;
        }

        .support__empty {
            margin: 0;
            font-size: 13px;
            opacity: 0.7;
            font-style: italic;
        }

        /* ─── Donate / Ko-fi ─── */
        .support__kofi {
            display: flex;
            justify-content: center;
        }

        .support__kofiCard {
            width: 100%;
            background: #ffffff;
            border-radius: 12px;
            padding: 6px;
        }

        .support__kofiFrame {
            display: block;
            width: 100%;
            height: 712px;
            border: 0;
            border-radius: 8px;
            background: transparent;
        }

        @media (max-width: 420px) {
            .support__kofiFrame {
                height: 760px;
            }
        }

        /* ─── Sponsor ─── */
        .support__sponsor {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: var(--space-3);
        }

        .support__stripeButton {
            display: inline-block;
            width: 250px;
            padding: 20px;
            background-color: white;
            color: black;
            text-align: center;
            font-weight: 600;
            text-decoration: none;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            transition: transform 180ms ease-out, box-shadow 180ms ease-out;
        }

        .support__stripeButton:hover {
            transform: scale(1.02);
            box-shadow: 6px -6px 0 0 #FFD400;
        }

        @media (prefers-reduced-motion: reduce) {
            .support__stripeButton:hover {
                transform: none;
            }
        }

        .support__posterLink {
            display: block;
            width: 100%;
            max-width: 100%;
        }

        .support__poster {
            max-width: 100%;
            height: auto;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            display: block;
        }
    </style>
</BaseLayout>