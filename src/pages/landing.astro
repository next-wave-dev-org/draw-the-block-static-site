---
import "../styles/global.css";
import "../styles/tokens.css";
import "../styles/base.css";
---

<main class="landing">
  <a href="/"><img src="/src/assets/eyes.svg" alt="DTB Eyes" /></a>
  <a href="/">[DRAW THE BLOCK]</a>
</main>

<style>
  html, body {
    margin: 0;
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
  }

  .landing {
    display: flex;
    flex-direction: column;
    gap: var(--space-6, 2rem);
    align-items: center;
  }

  .landing img {
    max-width: 520px;
    width: 100%;
    height: auto;
  }

  .landing a {
    text-decoration: none;
  }
</style>














