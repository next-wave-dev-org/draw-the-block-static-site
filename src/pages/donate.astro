---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="DRAW THE BLOCK — DONATE" current="donate">
  <main class="donate">
    <p class="donate__lede">Like what we are doing? Buy us a Ko-fi!</p>
    <section class="donate__kofi" aria-label="Support Draw The Block on Ko-fi">
      <div class="donate__kofiCard">
        <iframe
            class="donate__kofiFrame"
            id="kofiframe"
            src="https://ko-fi.com/drawtheblock/?hidefeed=true&widget=true&embed=true"
            title="Draw The Block Ko-fi"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </section>
  </main>
  <style>
    /* Allow us to manage donate width independently */
    :global(main.donate) {
      width: 420px;
      max-width: none;
      flex: 1 1 auto;
      min-width: 0;
    }

    .donate__lede {
      margin: 0;
      padding: 16px 0 10px;
      text-align: center;
      color: #ffffff;
      font-size: 16px;
      line-height: 1.4;
    }

    /* Ko-fi embed card */
    .donate__kofi {
      display: flex;
      justify-content: center;
      padding: 18px 0 48px; /* slightly tighter since lede exists now */
    }

    .donate__kofiCard {
      width: 100%;
      background: #ffffff;
      border-radius: 12px;
      padding: 6px;
    }

    .donate__kofiFrame {
      display: block;
      width: 100%;
      height: 712px;
      border: 0;
      border-radius: 8px;
      background: transparent;
    }

    @media (max-width: 420px) {
      .donate__kofiFrame {
        height: 760px;
      }
    }
  </style>

</BaseLayout>

