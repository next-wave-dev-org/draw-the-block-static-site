---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection, getEntry } from "astro:content";
import { Image } from "astro:assets";

const vendorSettings = await getEntry("vendorSettings", "vendors");
const vendors = await getCollection("vendors");

const sortedVendors = vendors.sort((a, b) =>
    a.data.name.localeCompare(b.data.name)
);
---

<BaseLayout title="DRAW THE BLOCK — VENDORS" current="vendors">
  <main>
    <div class="vendor-grid">
      {sortedVendors.map((vendor) => (
        <article class="vendor-card">
          <div class="image-frame">
            {vendor.data.image ? (
              <Image 
                src={vendor.data.image} 
                alt={vendor.data.name} 
                width={400} 
                height={400}
                format="webp"
                class="vendor-portrait"
              />
            ) : (
              <div class="placeholder" />
            )}
          </div>
          
          <h2 class="vendor-name">[{vendor.data.name}]</h2>

          <div class="social-links">
            {vendor.data.websiteUrl && (
                <a href={vendor.data.websiteUrl} target="_blank" rel="noopener noreferrer">
                  <img src="/images/website.png" alt="Website" class="social-icon" />
                </a>
            )}
            {vendor.data.instagramUrl && (
                <a href={vendor.data.instagramUrl} target="_blank" rel="noopener noreferrer">
                  <img src="/images/instagram.png" alt="Instagram" class="social-icon" />
                </a>
            )}
            {vendor.data.twitterUrl && (
                <a href={vendor.data.twitterUrl} target="_blank" rel="noopener noreferrer">
                  <img src="/images/x.png" alt="X" class="social-icon x-logo" />
                </a>
            )}
            {vendor.data.bskyUrl && (
                <a href={vendor.data.bskyUrl} target="_blank" rel="noopener noreferrer">
                  <img src="/images/bluesky.png" alt="Bluesky" class="social-icon" />
                </a>
            )}
          </div>
        </article>
      ))}
    </div>

    <section class="application-section">
      <hr class="divider" />
      <p class="app-status-title">[Vendor Applications]</p>
      <!--<p class="app-status-main">VENDOR APPLICATIONS CURRENTLY CLOSED</p>-->
      {vendorSettings?.data.vendorAppInfo && (
          <p class="app-info">{vendorSettings.data.vendorAppInfo}</p>
      )}

      <div class="button-container">
        {vendorSettings?.data.vendorApplicationUrl ? (
            <a href={vendorSettings.data.vendorApplicationUrl} target="_blank" rel="noopener noreferrer">
              <button class="apply-button">APPLY NOW</button>
            </a>
        ) : (
            <button class="placeholder-button" disabled>APPLICATIONS CLOSED</button>
        )}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .vendor-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 60px 30px;
    justify-items: center;
    padding: 2rem 0;
  }

  .vendor-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  .image-frame {
    width: 100%;
    aspect-ratio: 1 / 1;
    border: 1.5px solid #fff;
    background: #111;
    margin-bottom: 15px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .vendor-portrait {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .placeholder {
    width: 100%;
    height: 100%;
    background: #222;
  }

  .vendor-name {
    font-size: 1rem;
    font-family: serif;
    margin-bottom: 12px;
    font-weight: normal;
  }

  .social-links {
    display: flex;
    gap: 20px;
    justify-content: center;
    align-items: center;
  }

  .social-icon {
    width: 24px;
    height: 24px;
    transition: opacity 0.2s;
  }

  .x-logo {
    width: 20px;
  }

  .social-icon:hover {
    opacity: 0.6;
  }

  .application-section {
    margin-top: 100px;
    padding-bottom: 60px;
    text-align: center;
    text-transform: uppercase;
  }

  .divider {
    border: none;
    border-top: 1px solid #333;
    width: 60%;
    margin: 0 auto 40px auto;
  }

  .app-status-title {
    font-size: 0.9rem;
    margin-bottom: 10px;
    letter-spacing: 0.1rem;
  }

  .app-status-main {
    font-weight: bold;
    font-size: 1.1rem;
    margin-bottom: 5px;
  }

  .app-info {
    font-size: 0.8rem;
    color: #aaa;
    max-width: 500px;
    margin: 0 auto 30px auto;
    text-transform: lowercase;
    line-height: 1.4;
  }

  .apply-button {
    background-color: #ccc;
    color: #000;
    border: none;
    padding: 12px 40px;
    font-weight: bold;
    cursor: pointer;
    letter-spacing: 0.1rem;
  }

  .apply-button:hover {
    background-color: #fff;
  }

  .placeholder-button {
    background-color: #ccc;
    color: #000;
    border: none;
    padding: 12px 40px;
    font-weight: bold;
    cursor: not-allowed;
    letter-spacing: 0.1rem;
  }

  @media (max-width: 768px) {
    .vendor-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 480px) {
    .vendor-grid { grid-template-columns: 1fr; }
    .divider { width: 80%; }
  }
</style>
