---
// src/pages/events/index.astro
import BaseLayout from "../../layouts/BaseLayout.astro";
import Kicker from "../../components/Kicker.astro";
import EventCard from "../../components/EventCard.astro";
import { getCollection, type CollectionEntry } from "astro:content";

type EventEntry = CollectionEntry<"events">;

const events = (await getCollection("events")) as EventEntry[];

const sorted = events
    .slice()
    .sort(
        (a: EventEntry, b: EventEntry) =>
            a.data.startDate.getTime() - b.data.startDate.getTime()
    );

const now = new Date();

const upcoming = sorted.filter((e: EventEntry) =>
    e.data.endDate ? e.data.endDate >= now : e.data.startDate >= now
);
const past = sorted.filter((e: EventEntry) =>
    e.data.endDate ? e.data.endDate < now : e.data.startDate < now
);
---

<BaseLayout title="DRAW THE BLOCK — EVENTS" current="events">
  <main class="events stack">

    <section class="stack">
      <Kicker label="UPCOMING EVENTS" />

      {upcoming.length > 0 ? (
          <div class="eventsList">
            {upcoming.map((event: EventEntry) => (
                <EventCard
                    href={`/events/${event.slug}`}
                    title={event.data.title}
                    image={event.data.image}
                    description={event.data.description}
                    startDate={event.data.startDate}
                    endDate={event.data.endDate}
                    endTime={event.data.endTime}
                    location={event.data.location}
                />
            ))}
          </div>
      ) : (
          <p class="eventMeta">No upcoming events yet.</p>
      )}
    </section>

    <section class="stack">
      <Kicker label="PAST EVENTS" />

      {past.length > 0 ? (
          <div class="eventsList">
            {past.slice().reverse().map((event: EventEntry) => (
                <EventCard
                    href={`/events/${event.slug}`}
                    title={event.data.title}
                    image={event.data.image}
                    description={event.data.description}
                    startDate={event.data.startDate}
                    endDate={event.data.endDate}
                    endTime={event.data.endTime}
                    location={event.data.location}
                />
            ))}
          </div>
      ) : (
          <p class="eventMeta">No past events yet.</p>
      )}
    </section>
  </main>

  <style>
    .events {
      width: 100%;
      text-align: left;
      padding-top: var(--space-3);
    }

    .eventsList {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-4);
      /* Scale-up hover needs breathing room so the shadow doesn't clip. */
      padding: 8px;
    }

    @media (min-width: 720px) {
      .eventsList {
        grid-template-columns: 1fr 1fr;
        align-items: start;
      }
    }

    .eventMeta {
      margin: 0;
      font-size: 11px;
      letter-spacing: 0.02em;
      opacity: 0.95;
    }

  </style>
</BaseLayout>