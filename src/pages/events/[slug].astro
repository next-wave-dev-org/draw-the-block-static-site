---
// src/pages/events/[slug].astro
export const prerender = true;
import BaseLayout from "../../layouts/BaseLayout.astro";
import EventCard from "../../components/EventCard.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Kicker from "../../components/Kicker.astro";
import { getCollection, type CollectionEntry } from "astro:content";

type EventEntry = CollectionEntry<"events">;
type SubEventEntry = CollectionEntry<"subevents">;

export async function getStaticPaths() {
  const events = (await getCollection("events")) as EventEntry[];
  return events.map((event: EventEntry) => ({
    params: { slug: event.slug },
    props: { event },
  }));
}

const { event } = Astro.props as { event: EventEntry };
const { Content } = await event.render();

const allSubs = (await getCollection("subevents")) as SubEventEntry[];

const subevents = allSubs
    .filter((s: SubEventEntry) => s.data.parentEvent === event.slug)
    .slice()
    .sort(
        (a: SubEventEntry, b: SubEventEntry) =>
            a.data.startDate.getTime() - b.data.startDate.getTime()
    );

const sections: Array<{
  title: string;
  items: SubEventEntry[];
}> = [
  {
    title: "LIVE SHOWCASES",
    items: subevents.filter((s) => s.data.category === "liveShowcases"),
  },
  {
    title: "GAMES AND ACTIVITIES",
    items: subevents.filter((s) => s.data.category === "gamesAndActivities"),
  },
  {
    title: "CONTESTS",
    items: subevents.filter((s) => s.data.category === "contests"),
  },
  {
    title: "POP UPS",
    items: subevents.filter((s) => s.data.category === "popUps"),
  },
  {
    title: "COLLABORATIONS",
    items: subevents.filter((s) => s.data.category === "collaborations"),
  },
  {
    title: "OTHER",
    items: subevents.filter((s) => s.data.category === "other"),
  },
].filter((section) => section.items.length > 0);

const formatDateTime = (d: Date) =>
    d.toLocaleString(undefined, {
      year: "numeric",
      month: "numeric",
      day: "numeric",
      hour: "numeric",
      minute: "2-digit",
    });
---

<BaseLayout title={event.data.title} current="events" peek={{ side: "right", bottom: "200px" }}>
  <main class="events stack">
    <Breadcrumb items={[
      { label: "EVENTS", href: "/events" },
      { label: event.data.title.toUpperCase() }
    ]} />

    <section class="stack">
      <!--<Kicker label="EVENT" />-->

      {event.data.image && (
          <>
            <img
                class="detailImg"
                src={event.data.image}
                alt={event.data.title}
                data-lightbox-open
            />

            <dialog class="lightbox" data-lightbox>
              <button
                  type="button"
                  class="lightbox__close"
                  data-lightbox-close
                  aria-label="Close image"
              >
                ×
              </button>
              <img
                  class="lightbox__img"
                  src={event.data.image}
                  alt={event.data.title}
              />
            </dialog>
          </>
      )}

      <div class="eventPoster">
        <h1 class="eventTitle">{event.data.title}</h1>
      </div>

      {event.data.description && <p class="eventMeta">{event.data.description}</p>}

      <p class="eventMeta">
        <small>
          {formatDateTime(event.data.startDate)}
          {event.data.endDate
              ? ` – ${formatDateTime(event.data.endDate)}`
              : event.data.endTime
                  ? ` – ${event.data.endTime}`
                  : ""}
          {event.data.location && <br />}
          {event.data.location && <span>{event.data.location}</span>}
        </small>
      </p>

      {event.data.eventUrl && (
          <p class="eventMeta">
            <a href={event.data.eventUrl} target="_blank" rel="noreferrer">
              Event Link
            </a>
          </p>
      )}

      <hr />

      <Content />
    </section>

    {subevents.length > 0 && (
        <section class="stack">
          {sections.map((section) => (
              <div class="stack">
                <Kicker label={section.title} />

                <div class="eventsList">
                  {section.items.map((s: SubEventEntry) => (
                      <EventCard
                          href={`/events/${event.slug}/${s.slug}`}
                          title={s.data.title}
                          image={s.data.image}
                          description={s.data.description}
                          startDate={s.data.startDate}
                          endDate={s.data.endDate}
                          endTime={s.data.endTime}
                          location={s.data.location}
                      />
                  ))}
                </div>
              </div>
          ))}
        </section>
    )}
  </main>

  <style>
    .events {
      width: 100%;
      text-align: left;
    }

    .eventsList {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-4);
      margin-top: var(--space-2);
      /* Scale-up hover needs breathing room so the shadow doesn't clip. */
      padding: 8px;
    }

    @media (min-width: 720px) {
      .eventsList {
        grid-template-columns: 1fr 1fr;
        align-items: start;
      }
    }

    /* Full-size image on the main event detail view */
    .detailImg {
      width: 100%;
      height: auto;
      max-height: 70vh;
      object-fit: contain;
      display: block;
      margin-bottom: var(--space-2);
      cursor: zoom-in;
    }

    .lightbox[open] {
      /* Reset all the UA stylesheet positioning. Position fixed at all
         four edges = fullscreen, no margin: auto trick needed. */
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      margin: 0;
      width: 100%;
      height: 100%;
      max-width: none;
      max-height: none;
      padding: 0;
      border: none;
      background: transparent;

      /* Center the image. */
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    .lightbox::backdrop {
      background: rgba(0, 0, 0, 0.92);
    }

    .lightbox__img {
      display: block;
      max-width: 95vw;
      max-height: 95vh;
      width: auto;
      height: auto;
      /* Object-fit kept off — the max-* constraints handle scaling. */
    }

    .lightbox__close {
      position: fixed;
      top: 16px;
      right: 16px;
      z-index: 10;
      width: 44px;
      height: 44px;
      border: none;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.15);
      color: #fff;
      font-size: 28px;
      line-height: 1;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 150ms ease;
    }

    .lightbox__close:hover,
    .lightbox__close:focus-visible {
      background: rgba(255, 255, 255, 0.3);
      outline: none;
    }

    @media (prefers-reduced-motion: reduce) {
      .lightbox,
      .lightbox::backdrop {
        animation: none !important;
        transition: none !important;
      }
    }

    .eventPoster {
      background: #fff;
      color: #000;
      padding: 12px 14px;
      display: block;
      width: 100%;
      max-width: 100%;
      box-sizing: border-box;
      margin-bottom: 8px;
    }

    .eventTitle {
      margin: 0;
      font-size: 22px;
      font-weight: 800;
      text-transform: uppercase;
      line-height: 1.1;
    }

    .eventMeta {
      margin: 0;
      font-size: 11px;
      letter-spacing: 0.02em;
      opacity: 0.95;
    }

  </style>

  <script>
    function setupLightbox() {
      const trigger = document.querySelector<HTMLImageElement>("[data-lightbox-open]");
      const closeBtn = document.querySelector<HTMLButtonElement>("[data-lightbox-close]");
      const dialog = document.querySelector<HTMLDialogElement>("[data-lightbox]");

      if (!trigger || !closeBtn || !dialog) return;

      trigger.addEventListener("click", () => {
        dialog.showModal();
      });

      closeBtn.addEventListener("click", () => {
        dialog.close();
      });

      // Click-outside-image (on the backdrop) to close.
      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) {
          dialog.close();
        }
      });
    }

    setupLightbox();
    document.addEventListener("astro:page-load", setupLightbox);
  </script>
</BaseLayout>