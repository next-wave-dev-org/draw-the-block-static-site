---
// src/pages/events/[eventSlug]/[subSlug].astro
export const prerender = true;
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import Kicker from "../../../components/Kicker.astro";
import { getCollection, type CollectionEntry } from "astro:content";

type EventEntry = CollectionEntry<"events">;
type SubEventEntry = CollectionEntry<"subevents">;

export async function getStaticPaths() {
  const events = (await getCollection("events")) as EventEntry[];
  const subs = (await getCollection("subevents")) as SubEventEntry[];

  const validSubs = subs.filter((s) =>
      events.some((e) => e.slug === s.data.parentEvent)
  );

  // Attach the parent event to props so the template can render a full
  // breadcrumb without a second collection fetch per request.
  return validSubs.map((s) => {
    const parent = events.find((e) => e.slug === s.data.parentEvent)!;
    return {
      params: { eventSlug: s.data.parentEvent, subSlug: s.slug },
      props: { subevent: s, parent },
    };
  });
}

const { subevent, parent } = Astro.props as {
  subevent: SubEventEntry;
  parent: EventEntry;
};
const { Content } = await subevent.render();

const formatDateTime = (d: Date) =>
    d.toLocaleString(undefined, {
      year: "numeric",
      month: "numeric",
      day: "numeric",
      hour: "numeric",
      minute: "2-digit",
    });
---

<BaseLayout
    title={subevent.data.title}
    current="events"
    description={subevent.data.description}
>
  <main class="events stack">
    <Breadcrumb items={[
      { label: "EVENTS", href: "/events" },
      { label: parent.data.title.toUpperCase(), href: `/events/${parent.slug}` },
      { label: subevent.data.title.toUpperCase() }
    ]} />

    {subevent.data.image && (
        <>
          <img
              class="detailImg"
              src={subevent.data.image}
              alt={subevent.data.title}
              data-lightbox-open
          />

          <dialog class="lightbox" data-lightbox>
            <button
                type="button"
                class="lightbox__close"
                data-lightbox-close
                aria-label="Close image"
            >
              ×
            </button>
            <img
                class="lightbox__img"
                src={subevent.data.image}
                alt={subevent.data.title}
            />
          </dialog>
        </>
    )}

    <div class="eventPoster">
      <h1 class="eventTitle">{subevent.data.title}</h1>
    </div>

    {subevent.data.description && <p class="eventMeta">{subevent.data.description}</p>}

    <p class="eventMeta">
      <small>
        {formatDateTime(subevent.data.startDate)}
        {subevent.data.endDate
            ? ` – ${formatDateTime(subevent.data.endDate)}`
            : subevent.data.endTime
                ? ` – ${subevent.data.endTime}`
                : ""}
        {subevent.data.location && <br />}
        {subevent.data.location && <span>{subevent.data.location}</span>}
      </small>
    </p>

    {subevent.data.eventUrl && (
        <p class="eventMeta">
          <a href={subevent.data.eventUrl} target="_blank" rel="noreferrer">Link</a>
        </p>
    )}

    <hr />

    <Content />
  </main>

  <style>
    .events {
      width: 100%;
      text-align: left;
    }

    /* Detail image, capped at 70vh tall. Tall posters get scaled down
       so they fit in a reasonable amount of viewport. Click opens the
       full-size lightbox. */
    .detailImg {
      width: 100%;
      height: auto;
      max-height: 70vh;
      object-fit: contain;
      display: block;
      margin-bottom: var(--space-2);
      cursor: zoom-in;
    }

    .lightbox[open] {
      /* Reset all the UA stylesheet positioning. Position fixed at all
         four edges = fullscreen, no margin: auto trick needed. */
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      margin: 0;
      width: 100%;
      height: 100%;
      max-width: none;
      max-height: none;
      padding: 0;
      border: none;
      background: transparent;

      /* Center the image. */
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    .lightbox::backdrop {
      background: rgba(0, 0, 0, 0.92);
    }

    .lightbox__img {
      display: block;
      max-width: 95vw;
      max-height: 95vh;
      width: auto;
      height: auto;
      /* Object-fit kept off — the max-* constraints handle scaling. */
    }

    .lightbox__close {
      position: fixed;
      top: 16px;
      right: 16px;
      z-index: 10;
      width: 44px;
      height: 44px;
      border: none;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.15);
      color: #fff;
      font-size: 28px;
      line-height: 1;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 150ms ease;
    }

    .lightbox__close:hover,
    .lightbox__close:focus-visible {
      background: rgba(255, 255, 255, 0.3);
      outline: none;
    }

    @media (prefers-reduced-motion: reduce) {
      .lightbox,
      .lightbox::backdrop {
        animation: none !important;
        transition: none !important;
      }
    }

    .eventPoster {
      background: #fff;
      color: #000;
      padding: 12px 14px;
      display: block;
      width: 100%;
      max-width: 100%;
      box-sizing: border-box;
      margin-bottom: 8px;
    }

    .eventTitle {
      margin: 0;
      font-size: 22px;
      font-weight: 800;
      text-transform: uppercase;
      line-height: 1.1;
    }

    .eventMeta {
      margin: 0;
      font-size: 11px;
      letter-spacing: 0.02em;
      opacity: 0.95;
    }
  </style>
  <script>
    function setupLightbox() {
      const trigger = document.querySelector<HTMLImageElement>("[data-lightbox-open]");
      const closeBtn = document.querySelector<HTMLButtonElement>("[data-lightbox-close]");
      const dialog = document.querySelector<HTMLDialogElement>("[data-lightbox]");

      if (!trigger || !closeBtn || !dialog) return;

      trigger.addEventListener("click", () => {
        dialog.showModal();
      });

      closeBtn.addEventListener("click", () => {
        dialog.close();
      });

      // Click-outside-image (on the backdrop) to close.
      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) {
          dialog.close();
        }
      });
    }

    setupLightbox();
    document.addEventListener("astro:page-load", setupLightbox);
  </script>
</BaseLayout>