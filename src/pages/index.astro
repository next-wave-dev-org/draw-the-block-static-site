---
// src/pages/index.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import Countdown from "../components/Countdown.astro";
import { getCollection, type CollectionEntry } from "astro:content";

type EventEntry = CollectionEntry<"events">;

const events = (await getCollection("events")) as EventEntry[];

// Prefer the first featured event; fallback to first event if none are featured.
const featured = events.find((e) => e.data.featured) ?? null;

// Countdown target should always reflect the featured event start date.
// If no featured event exists, render the "No events planned" state.
const targetIso = featured ? featured.data.startDate.toISOString() : null;

const featuredTitle = featured?.data?.title ?? "";
const featuredSlug = featured?.slug ?? "";

const formatDateTime = (d: Date) =>
  d.toLocaleString(undefined, {
    year: "numeric",
    month: "numeric",
    day: "numeric",
    hour: "numeric",
    minute: "2-digit",
  });
---

<BaseLayout title="DRAW THE BLOCK — HOME" current="home">
  <div class="home">
    <!-- Intro -->
    <section class="home__intro">
      <div class="kicker">[ Manga and Comic Market ]</div>

      <p class="prose">
        Welcome to DRAW THE BLOCK, an anime and manga-inspired art market infused
        with hip-hop and cultural creativity! We're gathering interest from
        artists and vendors who want to be part of this vibrant event in Seattle
        on January 31st - February 1st. If you like anime, manga, and hip-hop
        culture, come have fun and support the block!
      </p>

      {featured && (
        <div class="featured">
          <div class="kicker featured__kicker">[ FEATURED EVENT ]</div>

          {featured.data.image && (
            <a class="featured__imgLink" href={`/events/${featuredSlug}`}>
              <div class="eventImgFrame">
                <img
                  class="cardImg"
                  src={featured.data.image}
                  alt={featured.data.title}
                  loading="lazy"
                />
              </div>
            </a>
          )}

          {featuredSlug ? (
            <a class="featured__title" href={`/events/${featuredSlug}`}>
              {featuredTitle}
            </a>
          ) : (
            <div class="featured__title">{featuredTitle}</div>
          )}

          <div class="featured__meta">
            {formatDateTime(featured.data.startDate)}
            {featured.data.endDate
              ? ` – ${formatDateTime(featured.data.endDate)}`
              : ""}
          </div>
        </div>
      )}
    </section>

    <!-- Countdown -->
    <section class="home__countdown" aria-label="Countdown to event">
      {targetIso ? (
        <>
          <Countdown targetIso={targetIso} />
        </>
      ) : (
        <div class="eventNone">
          <div class="kicker">[ NO EVENTS PLANNED ]</div>
          <p class="prose">Check back soon!</p>
        </div>
      )}
    </section>

    <!-- Mascot -->
    <section class="home__art" aria-label="Mascot">
      <img
        src="/images/mascot_flower.png"
        alt="Draw The Block mascot"
        class="home__mascot"
        loading="eager"
      />
    </section>
  </div>

  <style>
    .home {
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;

      gap: var(--space-6);
    }

    .home__intro {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-2);
    }

    .kicker {
      font-size: 12px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      opacity: 0.9;
      margin-top: var(--space-3);
    }

    /* Featured event block */
    .featured {
      width: 100%;
      max-width: 520px;
      margin-top: var(--space-3);
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      align-items: center;
    }

    .featured__kicker {
      margin-top: 0;
    }

    .featured__title {
      font-family: var(--font-display);
      font-weight: var(--fw-display);
      font-size: 20px;
      letter-spacing: 0.02em;
      text-transform: uppercase;
      text-decoration: none;
    }

    .featured__meta {
      font-size: 11px;
      letter-spacing: 0.02em;
      opacity: 0.95;
    }

    /* Countdown */
    .home__countdown {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-3);
      margin-top: var(--space-2);
    }

    .countdown__time {
      font-family: var(--font-display);
      font-weight: var(--fw-display);
      font-size: var(--fs-countdown);
      line-height: 1;
      letter-spacing: 0.02em;
    }

    .countdown__labels {
      display: flex;
      justify-content: center;
      gap: var(--space-4);
      font-size: 10px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      margin-top: var(--space-2);
    }

    .address {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      font-size: 11px;
      letter-spacing: 0.02em;
      opacity: 0.95;
    }

    /* Mascot */
    .home__art {
      width: 100%;
      display: flex;
      justify-content: center;
      margin-top: var(--space-6);
    }

    .home__mascot {
      width: 100%;
      max-width: 520px;
      height: auto;
      display: block;
    }

    .eventImgFrame {
      width: 100%;
      aspect-ratio: 16 / 9; /* or 4/3 if you prefer taller */
      overflow: hidden;
      background: rgba(255, 255, 255, 0.06);
      margin-bottom: var(--space-2);
    }

    .cardImg {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
      object-position: center;
    }

    .featured__imgLink {
      display: block;
      width: 100%;
      text-decoration: none;
      color: inherit;
    }

  </style>
</BaseLayout>