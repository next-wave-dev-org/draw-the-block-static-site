---
import BaseLayout from "../layouts/BaseLayout.astro";
import Countdown from "../components/Countdown.astro";
import { getCollection } from "astro:content";

const events = await getCollection("events");
const featured = events.find((e) => e.data.featured) ?? events[0];

const targetIso = featured?.data?.startDate
    ? featured.data.startDate.toISOString()
    : new Date("2026-01-31T10:00:00-08:00").toISOString();
const locationText = featured?.data?.location ?? "";
---

<BaseLayout title="DRAW THE BLOCK — HOME" current="home">
  <div class="home">
    <!-- Intro -->
    <section class="home__intro">
      <div class="kicker">[ Manga and Comic Market ]</div>

      <p class="prose">
        Welcome to DRAW THE BLOCK, an anime and manga-inspired art market infused
        with hip-hop and cultural creativity! We're gathering interest from
        artists and vendors who want to be part of this vibrant event in Seattle
        on January 31st - February 1st. If you like anime, manga, and hip-hop
        culture, come have fun and support the block!
      </p>
    </section>

    <!-- Countdown -->
    <section class="home__countdown" aria-label="Countdown to event">
      <Countdown targetIso={targetIso} />

      {locationText && (
          <div class="address">
            <span class="address__icon" aria-hidden="true">◯</span>
            <span>{locationText}</span>
          </div>
      )}
    </section>

    <!-- Mascot -->
    <section class="home__art" aria-label="Mascot">
      <img
          src="/images/mascot_flower.png"
          alt="Draw The Block mascot"
          class="home__mascot"
          loading="eager"
      />
    </section>
  </div>

  <style>
    .home {
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;

      /* Slightly tighter than global stack for the home column */
      gap: var(--space-6);
    }

    //.home .prose {
    //  max-width: clamp(40ch, 80%, 52ch);
    //}

    .home__intro {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-2);
    }

    .kicker {
      font-size: 12px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      opacity: 0.9;
      margin-top: var(--space-3);
    }

    /* Countdown */
    .home__countdown {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-3);
      margin-top: var(--space-2);
    }

    .countdown__time {
      font-family: var(--font-display);
      font-weight: var(--fw-display);
      font-size: var(--fs-countdown);
      line-height: 1;
      letter-spacing: 0.02em;
    }

    .countdown__labels {
      display: flex;
      justify-content: center;
      gap: var(--space-4);
      font-size: 10px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      margin-top: var(--space-2);
    }

    .address {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      font-size: 11px;
      letter-spacing: 0.02em;
      opacity: 0.95;
    }

    /* Mascot */
    .home__art {
      width: 100%;
      display: flex;
      justify-content: center;
      margin-top: var(--space-6);
    }

    .home__mascot {
      width: 100%;
      max-width: 520px;
      height: auto;
      display: block;
    }
  </style>
</BaseLayout>
