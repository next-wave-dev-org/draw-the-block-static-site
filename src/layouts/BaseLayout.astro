---
import "../styles/global.css";
import "../styles/tokens.css";
import "../styles/base.css";
import { getCollection, getEntry } from "astro:content";
import { ClientRouter } from 'astro:transitions';
import Marquee from "../components/Marquee.astro";
import PeekMascot, { type Props as PeekProps } from "../components/PeekMascot.astro";

type NavKey = "home" | "about" | "events" | "vendors" | "shop" | "support" | "faq" | "newsletter";

const {
  title = "DRAW THE BLOCK",
  current,
  peek = false,
} = Astro.props as {
  title?: string;
  current?: NavKey;
  peek?: PeekProps | false;
};

const socialSettings = await getEntry("settings", "social");
const { discordUrl, instagramUrl } = socialSettings?.data || {};


type MarqueeScope = "home" | "about" | "events" | "vendors" | "support" | "faq" | "global";

const pageScope: MarqueeScope | null =
    current && current !== "newsletter" ? (current as MarqueeScope) : null;

const marqueeAll = await getCollection("marqueeSettings");
const marqueeDoc = marqueeAll.find((m) => m.id === "marquee");

let activeMessages: string[] | null = null;
let activeSpeed: number | undefined = undefined;

if (marqueeDoc) {
  const scopes = marqueeDoc.data;
  const pageConfig = pageScope ? scopes[pageScope] : undefined;
  const globalConfig = scopes.global;

  if (pageConfig?.enabled) {
    if (pageConfig.messages.length > 0) {
      activeMessages = pageConfig.messages;
      activeSpeed = pageConfig.speed;
    }
  } else if (globalConfig?.enabled && globalConfig.messages.length > 0) {
    activeMessages = globalConfig.messages;
    activeSpeed = globalConfig.speed;
  }
}

/**
 * Header nav uses a "bracket-travel" indicator: two floating bracket glyphs
 * hug the active link at rest and slide to any link on hover. Active link
 * is tagged with `data-bt-active` from the `current` prop.
 *
 * Unlike the previous design, we do NOT wrap the active label in literal
 * [BRACKETS]. The floating brackets provide that affordance now. Keeping
 * both would produce nested/stacked brackets on the active item.
 */
const navItems: Array<{ key: NavKey; href: string; label: string }> = [
  { key: "home", href: "/home", label: "HOME" },
  { key: "about", href: "/about", label: "ABOUT" },
  { key: "events", href: "/events", label: "EVENTS" },
  { key: "vendors", href: "/vendors", label: "VENDORS" },
  { key: "shop", href: "/shop", label: "SHOP" },
  { key: "support", href: "/support", label: "SUPPORT" },
];



---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <ClientRouter/>
</head>

<body>
<main class="site-strip" aria-label="Main content">

  <img class="strip-logo" src="/images/logo.png" alt="Draw The Block logo" transition:persist />

  <header class="strip-header" aria-label="Site header">
    <nav class="strip-nav" aria-label="Primary navigation" data-bt-nav>
      {/* Floating brackets — JS translates these to the active or hovered link. */}
      <span class="strip-nav__bracket strip-nav__bracket--left" aria-hidden="true" data-bt-left>[</span>
      <span class="strip-nav__bracket strip-nav__bracket--right" aria-hidden="true" data-bt-right>]</span>

      {navItems.map((item) => (
          <a
              class="strip-nav__link"
              href={item.href}
              data-bt-link
              data-bt-active={current === item.key ? "" : undefined}
          >
            {item.label}
          </a>
      ))}
    </nav>

  </header>

  {activeMessages && (
      <Marquee messages={activeMessages} speed={activeSpeed} />
  )}

  <section class="strip-content">
    <slot />
  </section>

  <footer class="strip-footer" aria-label="Site footer">
    <nav class="strip-footer__links" data-bt-nav data-bt-scope="footer" aria-label="Footer links">
      {/* Floating brackets — JS translates these to the active or hovered link.
          Mirrors the header bracket-travel system; `data-bt-scope="footer"`
          is a CSS hook for the smaller footer-sized bracket type. */}
      <span class="bt-bracket bt-bracket--left" data-bt-left aria-hidden="true">[</span>
      <span class="bt-bracket bt-bracket--right" data-bt-right aria-hidden="true">]</span>

      <a
          class="strip-footer__link"
          href="/faq"
          data-bt-link
          data-bt-active={current === "faq" ? "" : undefined}
      >
        faq
      </a>
      <a
          class="strip-footer__link"
          href={discordUrl || "#"}
          target="_blank"
          rel="noreferrer"
          data-bt-link
      >
        discord
      </a>
      <a
          class="strip-footer__link"
          href={instagramUrl || "#"}
          target="_blank"
          rel="noreferrer"
          data-bt-link
      >
        instagram
      </a>
      <a
          class="strip-footer__link"
          href="/newsletter"
          data-bt-link
          data-bt-active={current === "newsletter" ? "" : undefined}
      >
        newsletter
      </a>
    </nav>
  </footer>
  {peek && <PeekMascot {...peek} />}
</main>

<style>
  .strip-logo {
    width: 240px;
    height: auto;
    display: block;
    margin: 0 auto;
    padding-top: var(--space-4);
  }

  .strip-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: var(--space-4);
  }

  .site-strip > :global(.marquee) {
    align-self: stretch;
    position: relative;
  }

  /* ═════════════════════════════════════════════════════════════
   * PRIMARY NAV — bracket-travel indicator
   *
   * - .strip-nav is position: relative so absolute children measure
   *   against it.
   * - Each link has data-bt-link; the active one adds data-bt-active.
   * - Two floating bracket spans are absolutely positioned.
   * - JS listens for mouseenter on links + mouseleave on nav to
   *   animate the brackets' translate3d position.
   * - Transform-only animation keeps things GPU-accelerated.
   * ═════════════════════════════════════════════════════════════ */
  .strip-nav {
    position: relative;
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    padding: 2px 24px;  /* horizontal padding gives brackets room around the outermost links */
    font-size: var(--fs-nav);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-family: var(--font-display);
  }

  .strip-nav__link {
    position: relative;
    text-decoration: none;
    color: inherit;
    padding: 2px 4px;
  }

  .strip-nav__bracket {
    position: absolute;
    top: 0;
    left: 0;
    pointer-events: none;
    color: inherit;
    /* JS sets --bt-x and --bt-y; --bt-y-nudge is a manual vertical
       fine-tune for webfont quirks. */
    --bt-x: -9999px;
    --bt-y: 0;
    --bt-y-nudge: 0px;
    transform: translate3d(var(--bt-x), calc(var(--bt-y) + var(--bt-y-nudge)), 0);
    transition: transform 300ms cubic-bezier(0.5, 0, 0.2, 1);
    will-change: transform;
  }

  /* Reveal brackets only after first measurement, to avoid pre-JS flash. */
  .strip-nav:not([data-bt-ready]) .strip-nav__bracket {
    opacity: 0;
  }
  .strip-nav[data-bt-ready] .strip-nav__bracket {
    opacity: 1;
    transition:
        transform 300ms cubic-bezier(0.5, 0, 0.2, 1),
        opacity 300ms ease-out;
  }

  /* When the nav has no active link (e.g. header on FAQ/Newsletter,
     or footer on home/about/etc.), hide the brackets at rest.
     Hover removes data-bt-floating via measureAndPlace, so brackets
     fade in. Mouseleave restores it, fading them back out. */
  .strip-nav[data-bt-floating] .strip-nav__bracket {
    opacity: 0;
  }

  /* ═════════════════════════════════════════════════════════════
   * FOOTER NAV — same bracket-travel system, smaller scale
   * ═════════════════════════════════════════════════════════════ */

  .bt-bracket {
    position: absolute;
    top: 0;
    left: 0;
    pointer-events: none;
    color: inherit;
    font-size: 0.85em;
    --bt-x: -9999px;
    --bt-y: 0;
    --bt-y-nudge: 1px;
    transform: translate3d(var(--bt-x), calc(var(--bt-y) + var(--bt-y-nudge)), 0);
    transition: transform 300ms cubic-bezier(0.5, 0, 0.2, 1);
    will-change: transform;
  }

  .strip-footer__links:not([data-bt-ready]) .bt-bracket {
    opacity: 0;
  }
  .strip-footer__links[data-bt-ready] .bt-bracket {
    opacity: 1;
    transition:
        transform 300ms cubic-bezier(0.5, 0, 0.2, 1),
        opacity 300ms ease-out;
  }
  .strip-footer__links[data-bt-floating] .bt-bracket {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .bt-bracket {
      transition: none !important;
    }
  }

  /* ═════════════════════════════════════════════════════════════
   * MAIN CONTENT, FOOTER
   * ═════════════════════════════════════════════════════════════ */
  .strip-content {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-top: var(--space-2);
  }

  .strip-footer {
    margin-top: auto;
    padding-top: var(--space-6);
    padding-bottom: var(--space-4);
    display: flex;
    justify-content: center;
    font-family: var(--font-display);
  }

  .strip-footer__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: lowercase;
    opacity: 0.95;
    position: relative;
  }

  .strip-footer__link {
    text-decoration: none;
  }


</style>

<script>
  /**
   * Bracket-travel nav — measures each link's position on mount and
   * animates two floating bracket glyphs between them on hover.
   *
   * Re-binds on astro:page-load so it survives ClientRouter navigations.
   * Uses a WeakMap to track per-nav state and avoid stacking listeners.
   */

  type NavState = {
    nav: HTMLElement;
    left: HTMLElement;
    right: HTMLElement;
    links: HTMLElement[];
    activeLink: HTMLElement | null;
    cleanup: () => void;
  };

  const states = new WeakMap<HTMLElement, NavState>();

  function measureAndPlace(state: NavState, targetLink: HTMLElement) {
    const navRect = state.nav.getBoundingClientRect();
    const linkRect = targetLink.getBoundingClientRect();

    const leftX = linkRect.left - navRect.left - state.left.offsetWidth - 2;
    const y = linkRect.top - navRect.top;
    state.left.style.setProperty("--bt-x", `${leftX}px`);
    state.left.style.setProperty("--bt-y", `${y}px`);

    const rightX = linkRect.right - navRect.left + 2;
    state.right.style.setProperty("--bt-x", `${rightX}px`);
    state.right.style.setProperty("--bt-y", `${y}px`);

    state.nav.removeAttribute("data-bt-floating");
  }

  function placeOnActive(state: NavState) {
    if (state.activeLink) {
      measureAndPlace(state, state.activeLink);
      state.nav.removeAttribute("data-bt-floating");
    } else {
      // No active top-nav item (e.g. on FAQ or Newsletter pages).
      // Hide brackets at rest; hover reveals them via measureAndPlace.
      state.nav.setAttribute("data-bt-floating", "");
    }
  }

  async function initNav(nav: HTMLElement) {
    // Tear down previous instance if re-initializing (e.g. after client-side nav).
    const prev = states.get(nav);
    if (prev) prev.cleanup();

    const left = nav.querySelector<HTMLElement>("[data-bt-left]");
    const right = nav.querySelector<HTMLElement>("[data-bt-right]");
    const links = Array.from(nav.querySelectorAll<HTMLElement>("[data-bt-link]"));
    const activeLink = nav.querySelector<HTMLElement>("[data-bt-active]");

    if (!left || !right || links.length === 0) return;

    const state: NavState = {
      nav,
      left,
      right,
      links,
      activeLink,
      cleanup: () => {},
    };

    // Wait for fonts so link widths are accurate before measuring.
    if (document.fonts && document.fonts.ready) {
      try {
        await document.fonts.ready;
      } catch {
        /* non-fatal */
      }
    }


    left.style.transition = "none";
    right.style.transition = "none";
    placeOnActive(state);
    // Force a reflow so the no-transition placement commits before we
    // restore the transition. Reading offsetWidth is a standard trick
    // for this — it flushes pending style/layout changes.
    void left.offsetWidth;
    void right.offsetWidth;
    // Clear the inline transition override so the stylesheet rule
    // (300ms cubic-bezier) takes over for hover transitions.
    left.style.transition = "";
    right.style.transition = "";

    nav.setAttribute("data-bt-ready", "");

    const onEnter = (e: Event) => {
      const link = e.currentTarget as HTMLElement;
      measureAndPlace(state, link);
    };
    links.forEach((l) => l.addEventListener("mouseenter", onEnter));

    const onLeave = () => placeOnActive(state);
    nav.addEventListener("mouseleave", onLeave);

    const ro = new ResizeObserver(() => placeOnActive(state));
    ro.observe(nav);

    state.cleanup = () => {
      links.forEach((l) => l.removeEventListener("mouseenter", onEnter));
      nav.removeEventListener("mouseleave", onLeave);
      ro.disconnect();
      nav.removeAttribute("data-bt-ready");
    };

    states.set(nav, state);
  }

  function initAll() {
    document.querySelectorAll<HTMLElement>("[data-bt-nav]").forEach(initNav);
  }

  document.addEventListener("astro:page-load", initAll);

  document.addEventListener("astro:before-swap", () => {
    document.querySelectorAll<HTMLElement>("[data-bt-nav]").forEach((nav) => {
      const s = states.get(nav);
      if (s) s.cleanup();
    });
  });
</script>
</body>
</html>