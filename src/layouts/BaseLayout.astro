---

import "../styles/global.css";
import "../styles/tokens.css";
import "../styles/base.css";

type NavKey = "home" | "about" | "events" | "vendors" | "sponsor" | "donate" | "faq";

const {
  title = "DRAW THE BLOCK",
  current,
} = Astro.props as {
  title?: string;
  current?: NavKey;
};

function navLabel(key: NavKey, label: string) {
  return current === key ? `[${label}]` : label;
}
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>


</head>

<body>
<main class="site-strip" aria-label="Main content">
  <header class="strip-header" aria-label="Site header">
    <img class="strip-logo" src="/images/logo.png" alt="Draw The Block logo" />

    <nav class="strip-nav" aria-label="Primary navigation">
      <a class:list={["strip-nav__link", current === "home" && "is-active"]} href="/">
        {navLabel("home", "HOME")}
      </a>
      <a class:list={["strip-nav__link", current === "about" && "is-active"]} href="/about">
        {navLabel("about", "ABOUT")}
      </a>
      <a class:list={["strip-nav__link", current === "events" && "is-active"]} href="/events">
        {navLabel("events", "EVENTS")}
      </a>
      <a class:list={["strip-nav__link", current === "vendors" && "is-active"]} href="/vendors">
        {navLabel("vendors", "VENDORS")}
      </a>
      <a class:list={["strip-nav__link", current === "sponsor" && "is-active"]} href="/sponsor">
        {navLabel("sponsor", "SPONSOR")}
      </a>
      <a class:list={["strip-nav__link", current === "donate" && "is-active"]} href="/donate">
        {navLabel("donate", "DONATE")}
      </a>
    </nav>
  </header>

  <section class="strip-content">
    <slot />
  </section>

  <footer class="strip-footer" aria-label="Site footer">
    <nav class="strip-footer__links" aria-label="Footer links">
      <a class:list={["strip-footer__link", current === "faq" && "is-active"]} href="/faq">
        {navLabel("faq", "faq")}
      </a>
      <a class="strip-footer__link" href="#" target="_blank" rel="noreferrer">discord</a>
      <a class="strip-footer__link" href="#" target="_blank" rel="noreferrer">instagram</a>
      <a class="strip-footer__link" href="#" target="_blank" rel="noreferrer">newsletter</a>
    </nav>
  </footer>
</main>

<style>
  .strip-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
  }

  .strip-logo {
    width: 240px;
    height: auto;
    display: block;
    /* margin-top: var(--space-2); */
  }

  .strip-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    font-size: var(--fs-nav);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-family: var(--font-display)
  }

  .strip-nav__link {
    text-decoration: none;
  }

  /* 3) Active page should NOT underline */
  .strip-nav__link.is-active {
    text-decoration: none;
  }

  .strip-content {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-top: var(--space-2);
  }

  /*  Footer inside strip and pinned to bottom */
  .strip-footer {
    margin-top: auto;
    padding-top: var(--space-6);
    padding-bottom: var(--space-4);
    display: flex;
    justify-content: center;
    font-family: var(--font-display);
  }

  .strip-footer__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: lowercase;
    opacity: 0.95;
  }

  .strip-footer__link {
    text-decoration: none;
  }

  .strip-footer__link.is-active {
    text-decoration: none;
  }
</style>
</body>
</html>
