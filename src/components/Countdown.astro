---
const { targetIso } = Astro.props as { targetIso: string };
---

<div class="countdown" data-target={targetIso}>
    <div class="countdown__time" data-el="time">00:00</div>
    <div class="countdown__labels">
        <span>WEEKS</span>
        <span>DAYS</span>
    </div>
</div>

<style>
    .countdown__time {
        font-family: var(--font-display);
        font-weight: var(--fw-display);
        font-size: var(--fs-countdown);
        line-height: 1;
        letter-spacing: 0.02em;
    }

    .countdown__labels {
        display: flex;
        justify-content: center;
        gap: var(--space-4);
        font-size: 10px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        margin-top: var(--space-2);
    }
</style>

<script is:inline>

    (function() {
        const scriptEl = document.currentScript;
        const root = scriptEl?.previousElementSibling;

        if (!root || !(root instanceof HTMLElement)) return;

        const targetAttr = root.dataset.target;
        const timeEl = root.querySelector('[data-el="time"]');
        if (!targetAttr || !timeEl) return;

        const target = new Date(targetAttr);

        function tick() {
            const now = Date.now();
            const diffMs = target.getTime() - now;

            if (diffMs <= 0) {
                timeEl.textContent = "00:00";
                return;
            }

            const daysTotal = Math.floor(diffMs / (1000 * 60 * 60 * 24));
            const weeks = Math.floor(daysTotal / 7);
            const days = daysTotal % 7;

            timeEl.textContent =
                String(weeks).padStart(2, "0") + ":" + String(days).padStart(2, "0");
        }

        tick();
        setInterval(tick, 60000);
    })();
</script>