---
const { targetIso } = Astro.props as { targetIso: string };
---

<div class="countdown" data-countdown data-target={targetIso}>
    <div class="countdown__time" data-el="time">00:00</div>
    <div class="countdown__labels">
        <span>WEEKS</span>
        <span>DAYS</span>
    </div>
</div>

<style>
    .countdown__time {
        font-family: var(--font-display);
        font-weight: var(--fw-display);
        font-size: var(--fs-countdown);
        line-height: 1;
        letter-spacing: 0.02em;
    }

    .countdown__labels {
        display: flex;
        justify-content: center;
        gap: var(--space-4);
        font-size: 10px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        margin-top: var(--space-2);
    }
</style>

<script>

    const intervals = new WeakMap<HTMLElement, number>();

    function startCountdown(root: HTMLElement) {
        const targetAttr = root.dataset.target;
        const timeEl = root.querySelector<HTMLElement>('[data-el="time"]');
        if (!targetAttr || !timeEl) return;

        const target = new Date(targetAttr);

        function tick() {
            const now = Date.now();
            const diffMs = target.getTime() - now;

            if (diffMs <= 0) {
                timeEl!.textContent = "00:00";
                const existing = intervals.get(root);
                if (existing !== undefined) {
                    clearInterval(existing);
                    intervals.delete(root);
                }
                return;
            }

            const daysTotal = Math.floor(diffMs / (1000 * 60 * 60 * 24));
            const weeks = Math.floor(daysTotal / 7);
            const days = daysTotal % 7;

            timeEl!.textContent =
                String(weeks).padStart(2, "0") + ":" + String(days).padStart(2, "0");
        }

        // Clear any existing interval on this element before starting a new one.
        const existing = intervals.get(root);
        if (existing !== undefined) clearInterval(existing);

        tick();
        const id = window.setInterval(tick, 60_000);
        intervals.set(root, id);
    }

    function initAllCountdowns() {
        const roots = document.querySelectorAll<HTMLElement>('[data-countdown]');
        roots.forEach(startCountdown);
    }

    // Runs on initial full page load AND after every client-side navigation.
    document.addEventListener("astro:page-load", initAllCountdowns);

    // Before a client-side navigation swaps the DOM, stop any running intervals.
    // The page-load handler will restart them if countdowns are still present.
    document.addEventListener("astro:before-swap", () => {
        document.querySelectorAll<HTMLElement>('[data-countdown]').forEach((root) => {
            const id = intervals.get(root);
            if (id !== undefined) {
                clearInterval(id);
                intervals.delete(root);
            }
        });
    });
</script>