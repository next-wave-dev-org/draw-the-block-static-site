---
/**
    * Breadcrumb — hierarchical orientation strip.
    *
    * Given an ordered list of items, renders them joined by a slash separator.
    * Items with `href` are rendered as links; the final (or any without `href`)
    * renders as plain text representing the current page.
    *
    * Usage:
    *   <Breadcrumb items={[
    *     { label: "EVENTS", href: "/events" },
    *     { label: event.data.title.toUpperCase() }
    *   ]} />
    *
    * Sits below the marquee and above the content's first kicker. Replaces
    * the old "Back to X" floating link + divider pattern.
    */

export interface BreadcrumbItem {
    label: string;
    href?: string;
}

export interface Props {
    items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav class="breadcrumb" aria-label="Breadcrumb">
    <ol class="breadcrumb__list">
        {items.map((item, i) => (
                <li class="breadcrumb__item">
                    {item.href ? (
                            <a class="breadcrumb__link" href={item.href}>{item.label}</a>
                    ) : (
                            <span class="breadcrumb__current" aria-current="page">{item.label}</span>
                    )}
                    {i < items.length - 1 && (
                            <span class="breadcrumb__sep" aria-hidden="true">/</span>
                    )}
                </li>
        ))}
    </ol>
</nav>

<style>
    .breadcrumb {
        width: 100%;
        font-family: var(--font-display), system-ui, sans-serif;
        font-weight: var(--fw-display, 700);
        font-size: 11px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        /*
         * Sits inside .strip-content which is center-aligned. We override
         * to left-align because breadcrumbs read left-to-right as a path.
         * Consumers can wrap in their own container if they want it elsewhere.
         */
        text-align: left;
    }

    .breadcrumb__list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0; /* spacing is handled by the separator */
    }

    .breadcrumb__item {
        display: inline-flex;
        align-items: center;
    }

    .breadcrumb__link {
        color: inherit;
        text-decoration: none;
        opacity: 0.85;
        transition: opacity 150ms ease-out;
    }

    .breadcrumb__link:hover {
        opacity: 1;
        text-decoration: underline;
        text-underline-offset: 3px;
    }

    .breadcrumb__current {
        opacity: 0.6;
    }

    .breadcrumb__sep {
        margin: 0 10px;
        opacity: 0.4;
    }
</style>