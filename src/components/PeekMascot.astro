---
/**
    * PeekMascot — a decorative character that peeks from the side band,
    * her hand resting on the central column edge.
    *
    * Positioned absolutely; the parent container must have `position:
    * relative` for anchoring. Set width, offset, and bottom via props
    * to tune per-page. Default values match the original About-page
    * placement that we tuned visually together.
    *
    * The `side` prop chooses which side band she lives in. When set to
    * "right", the asset is mirrored via CSS transform — handy for
    * variant assets, but also works with a single source asset that's
    * been drawn for one side.
    *
    * Hidden below 960px (no side band space at narrow viewports). The
    * breakpoint is per-component, not global, so future variants can
    * override if their proportions warrant it.
    */

export type PeekSide = "left" | "right";

export interface Props {
    src?: string;
    side?: PeekSide;
    width?: string;
    offset?: string;
    bottom?: string;
}

const {
    src = "/images/mascot_peek.png",
    side = "left",
    width = "280px",
    offset,
    bottom = "80px",
} = Astro.props;

// Build the inline style object so each instance can tune via props
// while sharing the same scoped CSS rules below.
const styleVars = [
    `--peek-width: ${width}`,
    offset ? `--peek-offset: ${offset}` : null,
    `--peek-bottom: ${bottom}`,
].join("; ");
---

<img
        class={`peek peek--${side}`}
        src={src}
        alt=""
        aria-hidden="true"
        loading="lazy"
        style={styleVars}
/>

<style>
    /*
     * The peek mascot positioning system.
     *
     * Anchored absolutely to the parent's edge. The `--peek-offset`
     * variable is set per-breakpoint as the column width changes, so
     * her hand stays roughly aligned with the column edge regardless
     * of viewport. Pages can still override via the `offset` prop —
     * the inline style takes precedence.
     *
     * The defaults below are calibrated assuming:
     *   - Mascot rendered at ~280px width
     *   - Asset has its character in the right ~50% of the frame
     *   - Column edge should land where her hand is drawn
     *
     * If you swap to a different mascot asset, you'll likely need to
     * re-tune the per-breakpoint offsets here.
     */
    .peek {
        /* Default offset — overridden inline by the offset prop, OR by
           the breakpoint-specific defaults below if no prop is passed. */
        --peek-offset-default: 15%;

        position: absolute;
        /* noinspection CssUnresolvedCustomProperty */
        bottom: var(--peek-bottom);
        /* noinspection CssUnresolvedCustomProperty */
        width: var(--peek-width);
        height: auto;
        pointer-events: none;
        user-select: none;
        z-index: 0;
    }

    .peek--left {
        right: 100%;
        /* Use the inline-set --peek-offset (from prop) if provided,
           otherwise fall back to the breakpoint-aware default. */
        /* noinspection CssUnresolvedCustomProperty */
        transform: translateX(var(--peek-offset, var(--peek-offset-default)));
    }

    .peek--right {
        left: 100%;
        /* noinspection CssUnresolvedCustomProperty */
        transform: translateX(calc(var(--peek-offset, var(--peek-offset-default)) * -1)) scaleX(-1);
    }

    /*
 * Peek mascot offset.
 *
 * Mascot is anchored to the .site-strip edge in BaseLayout, so her
 * offset from that edge SHOULD be constant regardless of viewport
 * width — the strip is her reference point, not the page width.
 *
 * In practice, the value is essentially 6.2em across all breakpoints,
 * with tiny rounding adjustments at edge cases. The 6.3em at 960px
 * compensates for subpixel rendering quirks at the column-min boundary;
 * the 6.22em at ultrawide handles a similar quirk further out.
 *
 * If you swap the mascot asset or change the rendered width (--peek-width
 * default of 280px), expect to re-tune. The 6.2em value is empirical to
 * the current 280px-wide mascot_peek.png asset.
 */
    @media (min-width: 960px) {
        .peek {
            --peek-offset-default: 6.3em;
        }
    }

    @media (min-width: 1025px) {
        .peek {
            --peek-offset-default: 6.2em;
        }
    }

    @media (min-width: 1441px) {
        .peek {
            --peek-offset-default: 6.2em;
        }
    }

    @media (min-width: 1921px) {
        .peek {
            --peek-offset-default: 6.2em;
        }
    }

    @media (max-width: 960px) {
        .peek {
            display: none;
        }
    }
</style>