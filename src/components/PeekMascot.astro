---
/**
    * PeekMascot — a decorative character that peeks from the side band,
    * her hand resting on the central column edge.
    *
    * Positioned absolutely; the parent container must have `position:
    * relative` for anchoring. Set width, offset, and bottom via props
    * to tune per-page. Default values match the original About-page
    * placement that we tuned visually together.
    *
    * The `side` prop chooses which side band she lives in AND picks
    * the matching asset:
    *   - side="left"  → mascot_peek_left.png   (default)
    *   - side="right" → mascot_peek_right.png
    *
    * Each side has its own asset, drawn for that side. There is no
    * mirroring — if you force the wrong asset onto the wrong side via
    * the `src` prop, you'll get a mascot facing away from the column.
    * Use the `mirror` prop to flip an asset onto the opposite side
    * (e.g. if you want to use the left asset on the right edge as a
    * fallback).
    *
    * Each side has its own per-breakpoint offset defaults, since the
    * two assets have their hands drawn in different positions within
    * their frames. Tune via the `offset` prop to override.
    *
    * Hidden below 960px (no side band space at narrow viewports). The
    * breakpoint is per-component, not global, so future variants can
    * override if their proportions warrant it.
    */

export type PeekSide = "left" | "right";

export interface Props {
    src?: string;
    side?: PeekSide;
    width?: string;
    offset?: string;
    bottom?: string;
    mirror?: boolean;
}

const {
    src,
    side = "left",
    width = "280px",
    offset,
    bottom = "80px",
    mirror = false,
} = Astro.props;

// If no explicit src, pick the side-appropriate asset.
const resolvedSrc = src ?? `/images/mascot_peek_${side}.png`;

// Build the inline style object so each instance can tune via props
// while sharing the same scoped CSS rules below.
const styleVars = [
    `--peek-width: ${width}`,
    offset ? `--peek-offset: ${offset}` : null,
    `--peek-bottom: ${bottom}`,
].join("; ");

const classes = ["peek", `peek--${side}`, mirror ? "peek--mirrored" : null]
    .filter(Boolean)
    .join(" ");
---

<img
        class={classes}
        src={resolvedSrc}
        alt=""
        aria-hidden="true"
        loading="lazy"
        style={styleVars}
/>

<style>
    /*
     * The peek mascot positioning system.
     *
     * Anchored absolutely to the parent's edge. The `--peek-offset`
     * variable is set per-breakpoint as the column width changes, so
     * her hand stays roughly aligned with the column edge regardless
     * of viewport. Pages can still override via the `offset` prop —
     * the inline style takes precedence.
     *
     * Per-side defaults: each asset has its hand drawn in a different
     * position relative to its frame, so each side gets its own
     * per-breakpoint default. Update the right-side values once we
     * eyeball the new asset in place.
     */
    .peek {
        /* Side-specific defaults. Each rule below sets these; the
           per-side selector picks which one applies. */
        --peek-offset-default-left: 15%;
        --peek-offset-default-right: 15%;

        position: absolute;
        /* noinspection CssUnresolvedCustomProperty */
        bottom: var(--peek-bottom);
        /* noinspection CssUnresolvedCustomProperty */
        width: var(--peek-width);
        height: auto;
        pointer-events: none;
        user-select: none;
        z-index: 0;
    }

    .peek--left {
        right: 100%;
        /* Use the inline-set --peek-offset (from prop) if provided,
           otherwise fall back to the breakpoint-aware left default. */
        /* noinspection CssUnresolvedCustomProperty */
        transform: translateX(var(--peek-offset, var(--peek-offset-default-left)));
    }

    .peek--right {
        left: 100%;
        /* Right-side translation pushes the asset leftward into the
           band (negative X). No mirror — the right-drawn asset is
           already correctly oriented. */
        /* noinspection CssUnresolvedCustomProperty */
        transform: translateX(calc(var(--peek-offset, var(--peek-offset-default-right)) * -1));
    }

    /* Optional flip — when `mirror` prop is true, scaleX(-1) is
       applied on top of the position transform. Useful for forcing
       the wrong-side asset onto a side as a fallback. */
    .peek--left.peek--mirrored {
        /* noinspection CssUnresolvedCustomProperty */
        transform: translateX(var(--peek-offset, var(--peek-offset-default-left))) scaleX(-1);
    }

    .peek--right.peek--mirrored {
        /* noinspection CssUnresolvedCustomProperty */
        transform: translateX(calc(var(--peek-offset, var(--peek-offset-default-right)) * -1)) scaleX(-1);
    }

    /*
     * Per-breakpoint offset defaults.
     *
     * Mascot is anchored to the .site-strip edge in BaseLayout, so her
     * offset from that edge SHOULD be constant regardless of viewport
     * width — the strip is her reference point, not the page width.
     *
     * The 6.2em value is empirical to the 280px-wide left asset.
     * The right asset starts at 6.2em as a placeholder — tune once
     * you eyeball it in place; her hand will land at a different
     * frame position than the left asset's hand does.
     *
     * If you swap either asset or change the rendered width
     * (--peek-width default of 280px), expect to re-tune.
     */
    @media (min-width: 960px) {
        .peek {
            --peek-offset-default-left: 6.3em;
            --peek-offset-default-right: 6.3em;
        }
    }

    @media (min-width: 1025px) {
        .peek {
            --peek-offset-default-left: 6.2em;
            --peek-offset-default-right: 6.2em;
        }
    }

    @media (min-width: 1441px) {
        .peek {
            --peek-offset-default-left: 6.2em;
            --peek-offset-default-right: 6.2em;
        }
    }

    @media (min-width: 1921px) {
        .peek {
            --peek-offset-default-left: 6.2em;
            --peek-offset-default-right: 6.2em;
        }
    }

    @media (max-width: 960px) {
        .peek {
            display: none;
        }
    }
</style>