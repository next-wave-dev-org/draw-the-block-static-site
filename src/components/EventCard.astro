---


export interface Props {
    href: string;
    title: string;
    image?: string;
    description?: string;
    startDate: Date;
    endDate?: Date;
    endTime?: string;
    location?: string;
    /**
     * When true, the card's image is loaded eagerly with high fetch priority.
     * Set this on the LCP candidate (the first featured card on home/events
     * index) — leave it off everywhere else so below-the-fold cards stay
     * lazy. Defaults to false.
     */
    eager?: boolean;
}

const {
    href,
    title,
    image,
    description,
    startDate,
    endDate,
    endTime,
    location,
    eager = false,
} = Astro.props;

/**
 * Title size tier, computed from character count at build time (no client
 * JS, no layout shift). Cards render at different widths depending on
 * context (single-featured, 2-col grid, events index list) — sized off
 * the card's own container width (cqw), not the viewport, so this scales
 * correctly wherever the card ends up.
 */
function titleSizeTier(t: string): "sm" | "md" | "lg" {
    const len = t.length;
    if (len <= 18) return "sm";
    if (len <= 32) return "md";
    return "lg";
}
const titleTier = titleSizeTier(title);

const formatDateTime = (d: Date) =>
    d.toLocaleString(undefined, {
        year: "numeric",
        month: "numeric",
        day: "numeric",
        hour: "numeric",
        minute: "2-digit",
    });

let timeSuffix = "";
if (endDate) {
    timeSuffix = ` – ${formatDateTime(endDate)}`;
} else if (endTime) {
    timeSuffix = ` – ${endTime}`;
}
---

<article class="eventCard">
    <a class="eventLink" href={href} title={title}>
        {image && (
                <div class="eventImgFrame">
                    <img
                            class="cardImg"
                            src={image}
                            alt={title}
                            loading={eager ? "eager" : "lazy"}
                            fetchpriority={eager ? "high" : "auto"}
                            decoding={eager ? "sync" : "async"}
                    />
                </div>
        )}

        <div class="eventPoster">
            <h2 class:list={["eventTitle", `eventTitle--${titleTier}`]}>{title}</h2>
        </div>
    </a>

    {description && <p class="eventMeta">{description}</p>}

    <p class="eventMeta">
        <small>
            {formatDateTime(startDate)}{timeSuffix}
            {location && <br />}
            {location && <span>{location}</span>}
        </small>
    </p>
</article>

<style>
    .eventCard {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
        width: 100%;
        min-width: 0;
    }

    .eventLink {
        display: block;
        width: 100%;
        min-width: 0;
        text-decoration: none;
        color: inherit;
        transition:
                transform 180ms ease-out,
                box-shadow 180ms ease-out;
    }


    @media (hover: hover) {
        .eventLink:hover {
            transform: scale(1.02);
            box-shadow: 6px -6px 0 0 #FFD400;
        }
    }

    @media (hover: hover) and (prefers-reduced-motion: reduce) {
        .eventLink {
            transition: box-shadow 180ms ease-out;
        }
        .eventLink:hover {
            transform: none;
        }
    }

    .eventImgFrame {
        width: 100%;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        background: rgba(255, 255, 255, 0.06);
    }

    .cardImg {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
        object-position: center;
    }

    .eventPoster {
        background: #fff;
        color: #000;
        padding: 12px 14px;
        display: block;
        width: 100%;
        max-width: 100%;
        min-width: 0;
        box-sizing: border-box;
        /* Lets .eventTitle size itself off this card's own width (cqw)
           rather than the viewport — the same card renders full-width,
           in a 2-col grid, and in the events list, all at once. */
        container-type: inline-size;
    }

    .eventTitle {
        margin: 0;
        font-weight: 800;
        text-transform: uppercase;
        line-height: 1.15;
        max-width: 100%;
        min-width: 0;
    }

    /* Short titles (the CMS-recommended length): full size, single line. */
    .eventTitle--sm {
        font-size: 22px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* Longer titles: shrink to still fit on one line. */
    .eventTitle--md {
        font-size: clamp(15px, 6.5cqw, 19px);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* Very long titles: shrink further and allow wrapping to two lines
       (rather than truncating a title down to near-illegibility). Anything
       that still overflows two lines at this size gets an ellipsis. */
    .eventTitle--lg {
        font-size: clamp(13px, 5.5cqw, 16px);
        white-space: normal;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    .eventMeta {
        margin: 0;
        font-size: 14px;
        letter-spacing: 0.02em;
        opacity: 0.95;
    }

    /* Description-to-date/time gap matches the event detail pages'
       .eventDetails spacing (var(--space-5)). The flex `gap` on
       .eventCard already contributes var(--space-2) between these two
       paragraphs, so only the remainder is added here. */
    .eventMeta + .eventMeta {
        margin-top: calc(var(--space-5) - var(--space-2));
    }
</style>