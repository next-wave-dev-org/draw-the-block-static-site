---


export interface Props {
    href: string;
    title: string;
    image?: string;
    description?: string;
    startDate: Date;
    endDate?: Date;
    endTime?: string;
    location?: string;
    /**
     * When true, the card's image is loaded eagerly with high fetch priority.
     * Set this on the LCP candidate (the first featured card on home/events
     * index) — leave it off everywhere else so below-the-fold cards stay
     * lazy. Defaults to false.
     */
    eager?: boolean;
}

const {
    href,
    title,
    image,
    description,
    startDate,
    endDate,
    endTime,
    location,
    eager = false,
} = Astro.props;

const formatDateTime = (d: Date) =>
    d.toLocaleString(undefined, {
        year: "numeric",
        month: "numeric",
        day: "numeric",
        hour: "numeric",
        minute: "2-digit",
    });

let timeSuffix = "";
if (endDate) {
    timeSuffix = ` – ${formatDateTime(endDate)}`;
} else if (endTime) {
    timeSuffix = ` – ${endTime}`;
}
---

<article class="eventCard">
    <a class="eventLink" href={href} title={title}>
        {image && (
                <div class="eventImgFrame">
                    <img
                            class="cardImg"
                            src={image}
                            alt={title}
                            loading={eager ? "eager" : "lazy"}
                            fetchpriority={eager ? "high" : "auto"}
                            decoding={eager ? "sync" : "async"}
                    />
                </div>
        )}

        <div class="eventPoster">
            <h2 class="eventTitle">{title}</h2>
        </div>
    </a>

    {description && <p class="eventMeta">{description}</p>}

    <p class="eventMeta">
        <small>
            {formatDateTime(startDate)}{timeSuffix}
            {location && <br />}
            {location && <span>{location}</span>}
        </small>
    </p>
</article>

<style>
    .eventCard {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
        width: 100%;
        min-width: 0;
    }

    .eventLink {
        display: block;
        width: 100%;
        min-width: 0;
        text-decoration: none;
        color: inherit;
        transition:
                transform 180ms ease-out,
                box-shadow 180ms ease-out;
    }


    @media (hover: hover) {
        .eventLink:hover {
            transform: scale(1.02);
            box-shadow: 6px -6px 0 0 #FFD400;
        }
    }

    @media (hover: hover) and (prefers-reduced-motion: reduce) {
        .eventLink {
            transition: box-shadow 180ms ease-out;
        }
        .eventLink:hover {
            transform: none;
        }
    }

    .eventImgFrame {
        width: 100%;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        background: rgba(255, 255, 255, 0.06);
    }

    .cardImg {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
        object-position: center;
    }

    .eventPoster {
        background: #fff;
        color: #000;
        padding: 12px 14px;
        display: block;
        width: 100%;
        max-width: 100%;
        min-width: 0;
        box-sizing: border-box;
    }

    .eventTitle {
        margin: 0;
        font-size: 22px;
        font-weight: 800;
        text-transform: uppercase;
        line-height: 1.15;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 100%;
        min-width: 0;
    }

    .eventMeta {
        margin: 0;
        font-size: 14px;
        letter-spacing: 0.02em;
        opacity: 0.95;
    }
</style>